{
  "name": "carteakey.dev",
  "version": "2.6.14",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "prebuild": "node ./utils/clean-build.mjs",
    "build": "npm-run-all -s build:*",
    "build:11ty": "eleventy",
    "build:css": "tailwindcss -i ./src/static/css/tailwind.css -o ./_site/css/tailwind.css --minify --postcss",
    "bench": "DEBUG=Eleventy:Benchmark* eleventy",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "start": "npm-run-all -p start:*",
    "start:11ty": "eleventy --serve",
    "start:css": "tailwindcss -i ./src/static/css/tailwind.css -o ./_site/css/tailwind.css --watch --postcss",
    "debug": "DEBUG=* eleventy",
    "metrics:merge-check": "node ./utils/check-engagement-merge.mjs",
    "newsletter:test": "node ./utils/send-newsletter-test.mjs",
    "audit:lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun --config=./lighthouserc.cjs",
    "verify:ui": "node ./utils/verify-ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/carteakey/carteakey.dev"
  },
  "author": {
    "name": "Kartikey Chauhan",
    "email": "kartychauhan@gmail.com",
    "url": "https://carteakey.dev/"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@netlify/functions": "^5.1.2",
    "@tailwindcss/cli": "^4.3.3",
    "@upstash/redis": "^1.36.2",
    "dotenv": "^17.3.1",
    "eleventy-plugin-toc": "^1.1.5",
    "exif-reader": "^2.0.3",
    "inquirer": "^13.3.0",
    "js-yaml": "^4.3.0",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-emoji": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "openai": "^6.46.0",
    "sharp": "^0.35.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "eleventy-plugin-feathericons": "^2.0.0",
    "netlify-plugin-cache": "^1.0.3",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3"
  }
}
