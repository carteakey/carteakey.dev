---
layout: layouts/base.njk
title: Changelog
description: A history of changes and new features on this site.
permalink: /changelog/
eleventyNavigation:
  key: Changelog
  order: 9
collectionArchetype: index
---

{% include "components/breadcrumbs.njk" %}

{% set pageTitle = "Changelog" %}
{% set pageDescription = "A running history of site changes." %}
{% set pageActions = [ { label: "Raw ↗", href: "https://github.com/carteakey/carteakey.dev/blob/main/docs/CHANGELOG.md", external: true } ] %}
{% include "components/page-header.njk" %}

<div class="not-prose relative">
  {# vertical timeline line #}
  <div class="absolute left-[0.4rem] top-2 bottom-2 w-px bg-gray-200 dark:bg-gray-800"></div>

  <ul class="list-none m-0 p-0 space-y-8 pl-7">
    {% for entry in changelog %}
    <li class="relative">
      <div class="absolute -left-7 top-1.5 w-3 h-3 border-2 border-white dark:border-zinc-950 {% if entry.fromGit %}bg-gray-400 dark:bg-gray-600{% else %}bg-[color:var(--accent-color)]{% endif %}"></div>

      <div class="flex flex-wrap items-baseline gap-3 mb-2">
        {% if entry.fromGit %}
          <span class="font-mono font-semibold editorial-support-compact">{{ entry.version }}</span>
          <span class="meta-line">git history</span>
        {% else %}
          <span class="editorial-title-sm text-[color:var(--accent-color)]">v{{ entry.version }}</span>
          {% if entry.date %}
            <time class="meta-line">{{ entry.date }}</time>
          {% endif %}
        {% endif %}
      </div>

      <div class="space-y-2">
        {% if entry.sections.Added %}
        <div>
          <span class="editorial-kicker mr-2">Added</span>
          <ul class="mt-1 space-y-0.5 list-none m-0 p-0">
            {% for item in entry.sections.Added %}
            <li class="editorial-support-compact flex gap-2">
              <span class="meta-line shrink-0 mt-0.5">+</span>
              <span>{{ item }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if entry.sections.Changed %}
        <div>
          <span class="editorial-kicker mr-2">{% if entry.fromGit %}Commits{% else %}Changed{% endif %}</span>
          <ul class="mt-1 space-y-0.5 list-none m-0 p-0">
            {% for item in entry.sections.Changed %}
            <li class="editorial-support-compact flex gap-2">
              <span class="meta-line shrink-0 mt-0.5">{% if entry.fromGit %}·{% else %}~{% endif %}</span>
              <span>{{ item }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if entry.sections.Fixed %}
        <div>
          <span class="editorial-kicker mr-2">Fixed</span>
          <ul class="mt-1 space-y-0.5 list-none m-0 p-0">
            {% for item in entry.sections.Fixed %}
            <li class="editorial-support-compact flex gap-2">
              <span class="meta-line shrink-0 mt-0.5">⚑</span>
              <span>{{ item }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if entry.sections.Removed %}
        <div>
          <span class="editorial-kicker mr-2">Removed</span>
          <ul class="mt-1 space-y-0.5 list-none m-0 p-0">
            {% for item in entry.sections.Removed %}
            <li class="editorial-support-compact flex gap-2">
              <span class="meta-line shrink-0 mt-0.5">−</span>
              <span>{{ item }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</div>
