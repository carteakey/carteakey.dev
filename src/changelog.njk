---
layout: layouts/base.njk
title: Changelog
description: A history of changes and new features on this site.
permalink: /changelog/
eleventyNavigation:
  key: Changelog
  order: 9
collectionArchetype: index
---

{% include "components/breadcrumbs.njk" %}

{% set pageTitle = "Changelog" %}
{% set pageDescription = "A running history of site changes, a month at a time." %}
{% set pageActions = [ { label: "Raw ↗", href: "https://github.com/carteakey/carteakey.dev/blob/main/docs/CHANGELOG.md", external: true } ] %}
{% include "components/page-header.njk" %}

{% set marks = { Added: "+", Changed: "~", Fixed: "⚑", Removed: "−" } %}

{# Months: summary always visible, releases folded. Only the newest month starts open. #}
<ol class="not-prose changelog">
  {% for month in changelog %}
  {% set c = month.counts %}
  <li class="changelog-month{% if not c.releases %} changelog-month-git{% endif %}">
    <h2 class="editorial-title-compact changelog-month-title" id="{{ month.key }}">{{ month.label }}</h2>
    {% if month.summary %}
      <p class="editorial-support changelog-summary">{{ month.summary | safe }}</p>
    {% endif %}

    <details class="changelog-releases"{% if loop.first %} open{% endif %}>
      <summary class="meta-text changelog-count">
        {%- if c.releases -%}
          {{ c.releases }} release{% if c.releases != 1 %}s{% endif %}
          {%- for kind, mark in marks %}{% if c[kind] %} · {{ c[kind] }} {{ kind | lower }}{% endif %}{% endfor %}
          {%- if c.commits %} · {{ c.commits }} commits from git{% endif %}
        {%- else -%}
          {{ c.commits }} commit{% if c.commits != 1 %}s{% endif %} · git history
        {%- endif -%}
      </summary>

      <ol class="changelog-versions">
        {% for entry in month.versions %}
        <li class="changelog-version">
          <div class="changelog-version-head">
            {% if entry.fromGit %}
              <span class="meta-text">Commits</span>
            {% else %}
              <span class="changelog-version-num">v{{ entry.version }}</span>
              <time class="meta-text" datetime="{{ entry.date }}">{{ entry.date }}</time>
            {% endif %}
          </div>
          {% for kind, mark in marks %}
            {% if entry.sections[kind] %}
            <div class="changelog-section">
              {% if not entry.fromGit %}<span class="editorial-kicker">{{ kind }}</span>{% endif %}
              <ul class="changelog-items">
                {% for item in entry.sections[kind] %}
                <li>
                  <span class="changelog-mark" aria-hidden="true">{% if entry.fromGit %}·{% else %}{{ mark }}{% endif %}</span>
                  <span>
                    {{ item.html | safe }}
                    {% if item.children.length %}
                    <ul class="changelog-subitems">
                      {% for child in item.children %}<li>{{ child | safe }}</li>{% endfor %}
                    </ul>
                    {% endif %}
                  </span>
                </li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}
          {% endfor %}
        </li>
        {% endfor %}
      </ol>
    </details>
  </li>
  {% endfor %}
</ol>
