---
layout: layouts/base.njk
title: Stats
description: Numbers and insights about this site.
eleventyNavigation:
  key: Stats
  order: 9
permalink: /stats/
collectionArchetype: ledger
---

{% include "components/breadcrumbs.njk" %}
{% from "components/authorship-badge.njk" import authorshipBadge %}
{% import "components/cartebase-charts.njk" as cb %}

{% set pageTitle = "Stats" %}
{% set pageDescription = "Numbers. Updated every build." %}
{% include "components/page-header.njk" %}

{# ── Compute stats using filters ── #}
{% set totalWords = collections.posts | sumWordCounts %}
{% set avgWords = 0 %}
{% if collections.posts.length > 0 %}
  {% set avgWords = (totalWords / collections.posts.length) | round %}
{% endif %}
{% set byYear = collections.posts | countByYear %}
{% set years = byYear | keys | sort | reverse %}
{% set maxPerYear = 1 %}
{% for yr in years %}
  {% if byYear[yr] > maxPerYear %}{% set maxPerYear = byYear[yr] %}{% endif %}
{% endfor %}

{% set currentYear = "now" | date("Y") %}
{% set currentMonth = "now" | date("n") %}
{% set postsThisYear = byYear[currentYear] | default(0) %}
{% set postsThisMonth = collections.posts | countInYearMonth(currentYear, currentMonth) %}

{% set totalUpvotes = 0 %}
{% for slug, count in upvotes.posts %}
  {% set totalUpvotes = totalUpvotes + count %}
{% endfor %}

{% set postsPerYearData = [] %}
{% for yr in byYear | keys | sort %}
  {% set _ = postsPerYearData.push({ year: yr, count: byYear[yr] }) %}
{% endfor %}

{# ── Hero stat tiles with sparkline ── #}
<div class="not-prose grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
  {{ cb.stat_tile("Posts", collections.posts.length | localeNumber, "since " ~ (years | last), chartSvg({ type: "spark", data: postsPerYearData, x: "year", y: "count" })) }}
  {{ cb.stat_tile("Words", (totalWords | numberString), (avgWords | numberString) ~ " avg / post") }}
  {{ cb.stat_tile("Snippets", collections.snippets.length | localeNumber, (collections.notes.length | localeNumber) ~ " notes") }}
  {{ cb.stat_tile("Upvotes", totalUpvotes | localeNumber, "all-time total") }}
</div>

{{ cb.section_header("Writing", "Publishing cadence and volume", "edit-3") }}

<div class="mb-10">
  {% chart {
    type: "bars",
    data: postsPerYearData,
    x: "year",
    y: "count",
    kicker: "Archive · posts per year",
    title: "Publishing cadence, " ~ (years | last) ~ "–" ~ (years | first),
    highlight: "max",
    xTicks: 8,
    source: "carteakey.dev collections",
    n: collections.posts.length,
    range: (years | last) ~ " – " ~ (years | first),
    xLabel: "year",
    yLabel: "posts",
    table: false
  } %}
</div>

{# ── Inventory & Authorship breakdown ── #}
<div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-10 mb-12">
  <div>
    <h3 class="editorial-kicker mb-4">Inventory</h3>
    <div class="divide-y divide-gray-100 dark:divide-gray-800/80">
      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Total words</span>
        <span class="editorial-title-compact">{{ totalWords | numberString }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Avg words / post</span>
        <span class="editorial-title-compact">{{ avgWords | numberString }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Posts this year</span>
        <span class="editorial-title-compact">{{ postsThisYear }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Posts this month</span>
        <span class="editorial-title-compact">{{ postsThisMonth }}</span>
      </div>

      {% set latestPost = collections.posts | sortByDate | first %}
      {% if latestPost %}
      <div class="py-2.5 flex items-baseline justify-between gap-4">
        <span class="editorial-support shrink-0">Latest</span>
        <a href="{{ latestPost.url }}" class="editorial-title-link-compact text-right truncate min-w-0" style="text-decoration:none;">{{ latestPost.data.title }}</a>
      </div>
      {% endif %}

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Post tags</span>
        <span class="editorial-title-compact">{{ collections.tagList.length }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Notes</span>
        <span class="editorial-title-compact">{{ collections.notes.length | localeNumber }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Total pages</span>
        <span class="editorial-title-compact">{{ collections.all.length }}</span>
      </div>

      <div class="py-2.5 flex items-baseline justify-between">
        <span class="editorial-support">Last build</span>
        <span class="meta-text">{{ "now" | date('MMM d, yyyy') }} · {{ "now" | date('h:mm a') }}</span>
      </div>
    </div>
  </div>

  <div>
    <h3 class="editorial-kicker mb-4">Authorship breakdown</h3>
    {% set authStats = collections.posts | computeAuthorship(collections.snippets, collections.notes) %}
    
    <div class="flex h-3 w-full bg-gray-100 dark:bg-gray-800 rounded-sm overflow-hidden mb-6">
      {% if authStats.pctHuman > 0 %}
        <div class="h-full" style="width: {{ authStats.pctHuman }}%; background: var(--accent-color);" title="Human: {{ authStats.human }} ({{ authStats.pctHuman }}%)"></div>
      {% endif %}
      {% if authStats.pctAssisted > 0 %}
        <div class="h-full" style="width: {{ authStats.pctAssisted }}%; background: color-mix(in srgb, var(--accent-color) 55%, transparent);" title="AI Assisted: {{ authStats.assisted }} ({{ authStats.pctAssisted }}%)"></div>
      {% endif %}
      {% if authStats.pctGenerated > 0 %}
        <div class="h-full" style="width: {{ authStats.pctGenerated }}%; background: color-mix(in srgb, var(--accent-color) 25%, transparent);" title="AI Generated: {{ authStats.generated }} ({{ authStats.pctGenerated }}%)"></div>
      {% endif %}
      {% if authStats.pctUnclassified > 0 %}
        <div class="h-full bg-stone-300 dark:bg-stone-700" style="width: {{ authStats.pctUnclassified }}%;" title="Unclassified: {{ authStats.unclassified }} ({{ authStats.pctUnclassified }}%)"></div>
      {% endif %}
    </div>

    <div class="divide-y divide-gray-100 dark:divide-gray-800/80">
      <div class="py-2.5 flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: var(--accent-color);"></span>
          <span class="editorial-support">Human</span>
        </span>
        <span class="editorial-title-compact">{{ authStats.human }} <span class="text-xs text-gray-500 font-normal">({{ authStats.pctHuman }}%)</span></span>
      </div>
      <div class="py-2.5 flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: color-mix(in srgb, var(--accent-color) 55%, transparent);"></span>
          <span class="editorial-support">AI Assisted</span>
        </span>
        <span class="editorial-title-compact">{{ authStats.assisted }} <span class="text-xs text-gray-500 font-normal">({{ authStats.pctAssisted }}%)</span></span>
      </div>
      <div class="py-2.5 flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: color-mix(in srgb, var(--accent-color) 25%, transparent);"></span>
          <span class="editorial-support">AI Generated</span>
        </span>
        <span class="editorial-title-compact">{{ authStats.generated }} <span class="text-xs text-gray-500 font-normal">({{ authStats.pctGenerated }}%)</span></span>
      </div>
      {% if authStats.unclassified > 0 %}
      <div class="py-2.5 flex items-center justify-between">
        <span class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-stone-300 dark:bg-stone-700"></span>
          <span class="editorial-support">Unclassified</span>
        </span>
        <span class="editorial-title-compact">{{ authStats.unclassified }} <span class="text-xs text-gray-500 font-normal">({{ authStats.pctUnclassified }}%)</span></span>
      </div>
      {% endif %}
      <div class="py-2.5 flex items-center justify-between font-bold">
        <span class="editorial-support font-semibold">Total Writings</span>
        <span class="editorial-title-compact">{{ authStats.total }}</span>
      </div>
    </div>
  </div>
</div>

{# ── Recent writings timeline ── #}
{% set rhythm = collections.posts | countByYearMonth(collections.notes, collections.snippets) %}
<div class="mb-12">
  {% chart {
    type: "heatmap",
    matrix: rhythm.matrix,
    rows: rhythm.rows,
    cols: rhythm.cols,
    colEvery: 1,
    colSuffix: "",
    unit: "pieces",
    kicker: "Archive · posts, notes and snippets by month",
    title: "Busiest month: " ~ rhythm.peak.label ~ ", with " ~ rhythm.peak.count ~ " pieces",
    caption: "Bigger dot = more published that month.",
    source: "carteakey.dev collections",
    n: collections.posts.length + collections.notes.length + collections.snippets.length
  } %}
</div>

{{ cb.section_header("Recent writings", "Latest posts, snippets and notes with authorship", "clock") }}

{% set timeline = collections.posts | writingsTimeline(collections.snippets, collections.notes, 12) %}
<div class="not-prose mb-12">
  <div class="flex flex-col">
    {% for item in timeline %}
    <div class="py-2 flex items-center justify-between border-b border-gray-100 dark:border-gray-800/80 last:border-0 gap-4">
      <div class="flex items-center gap-2 min-w-0">
        <span class="meta-text text-[0.78rem] uppercase border border-gray-200 dark:border-gray-700 px-1 py-0.5 rounded-sm shrink-0">{{ item.type }}</span>
        {% if item.url %}
          <a href="{{ item.url }}" class="editorial-title-link-compact truncate" style="text-decoration:none;">{{ item.title }}</a>
        {% else %}
          <span class="editorial-title-compact text-gray-500 truncate">{{ item.title }}</span>
        {% endif %}
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="meta-text text-[0.78rem] text-gray-500 whitespace-nowrap">{{ item.date | date('MMM d, Y') }}</span>
        {{ authorshipBadge(item.authored_by, compact=true) }}
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{# ── Lighthouse ── #}
{# Monthly LHCI run (lighthouserc.cjs), appended by utils/lighthouse-history.mjs. #}
{% if lighthouse.runs and lighthouse.runs.length %}
{% set lhLatest = lighthouse.runs | last %}
{% set lhHead = lhLatest.pages[lighthouse.headline] %}
{% set lhLabels = { performance: "Performance", accessibility: "Accessibility", bestPractices: "Best Practices", seo: "SEO" } %}
{{ cb.section_header("Lighthouse", "Monthly audit, homepage headline", "activity") }}

<div class="not-prose mb-4">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {% for key, label in lhLabels %}
      {% set lhSeries = [] %}
      {% for run in lighthouse.runs %}
        {% if run.pages[lighthouse.headline] %}
          {% set _ = lhSeries.push({ date: run.date, score: run.pages[lighthouse.headline][key] }) %}
        {% endif %}
      {% endfor %}
      {{ cb.stat_tile(label, lhHead[key], "homepage", chartSvg({ type: "spark", data: lhSeries, x: "date", y: "score" }) if lhSeries.length > 1 else "") }}
    {% endfor %}
  </div>
</div>

<div class="table-scroll mb-3" role="region" aria-label="Lighthouse scores by page" tabindex="0">
<table>
  <thead>
    <tr><th>Page</th><th>Perf</th><th>A11y</th><th>Best</th><th>SEO</th><th>LCP</th><th>CLS</th><th>TBT</th></tr>
  </thead>
  <tbody>
    {% for path, page in lhLatest.pages %}
    <tr>
      {% set lhSlug = path | replace(r/\/$/, "") | split("/") | last %}
      <td><a href="{{ path | url }}" title="{{ path }}">{{ path if path.length < 24 else "…/" + (lhSlug | truncate(22, true, "…")) }}</a></td>
      <td>{{ page.performance }}</td>
      <td>{{ page.accessibility }}</td>
      <td>{{ page.bestPractices }}</td>
      <td>{{ page.seo }}</td>
      <td>{{ (page.lcp / 1000) | round(1) }} s</td>
      <td>{{ page.cls }}</td>
      <td>{{ page.tbt }} ms</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
<p class="not-prose editorial-support-compact mb-12">{{ lhLatest.date }} · {{ lhLatest.source }} · mobile emulation, median of three runs, {{ lighthouse.runs.length }} run{% if lighthouse.runs.length != 1 %}s{% endif %} on record.</p>
{% endif %}

{# ── Top tags ── #}
{{ cb.section_header("Top tags", "Most frequent taxonomy", "tag") }}

<div class="not-prose mb-12">
  <div class="flex flex-wrap gap-1.5">
    {% for tag in collections.tagList | head(20) %}
      {% set tagCount = collections[tag].length %}
      {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
      <a href="{{ tagUrl | url }}" class="badge badge-tag" style="text-decoration:none;">
        {{ tag }}<span class="opacity-50 ml-1">{{ tagCount }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{# ── Stack ── #}
{{ cb.section_header("Stack", "Architecture and services", "server") }}

<div class="not-prose mb-8">
  <div class="divide-y divide-gray-100 dark:divide-gray-800/80">
    <div class="py-2.5 flex justify-between"><span class="editorial-support">Generator</span><span class="meta-text">{{ eleventy.generator }}</span></div>
    <div class="py-2.5 flex justify-between"><span class="editorial-support">CSS</span><span class="meta-text">Tailwind CSS v4</span></div>
    <div class="py-2.5 flex justify-between"><span class="editorial-support">JS</span><span class="meta-text">Alpine.js</span></div>
    <div class="py-2.5 flex justify-between"><span class="editorial-support">Hosting</span><span class="meta-text">Netlify</span></div>
    <div class="py-2.5 flex justify-between"><span class="editorial-support">Comments</span><span class="meta-text">Giscus</span></div>
    <div class="py-2.5 flex justify-between"><span class="editorial-support">Analytics</span><span class="meta-text">None (privacy-first)</span></div>
  </div>
</div>
