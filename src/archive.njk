---
layout: layouts/base.njk
title: Writing
description: Writing, tutorials, and thoughts on tech, life, and everything in between
permalink: /blog/
eleventyNavigation:
  key: Writing
  order: 2
collectionArchetype: index
---

{% from "components/authorship-badge.njk" import authorshipBadge %}
{% from "components/feed-card.njk" import postListRow %}
{% include "components/breadcrumbs.njk" %}
{% set byYear = collections.posts | countByYear %}
{% set archiveYears = byYear | keys | sort | reverse %}
{% set pageEyebrow = "Long-form Writing" %}
{% set pageTitle = "Writing" %}
{% set pageDescription = "Essays, engineering deep dives, tutorials, and series." %}
{% set itemCount = collections.posts | length %}
{% set itemLabel = "posts" %}

<div>
  {% include "components/page-header.njk" %}

  <div class="not-prose flex items-center justify-between mb-3 gap-3 flex-wrap">
    <div class="relative">
      {% feather "search", class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" %}
      <input
        type="search"
        id="blogSearch"
        placeholder="Search essays..."
        aria-label="Search essays"
        class="rounded-sm border border-gray-200 dark:border-gray-700 bg-transparent py-1.5 pl-8 pr-3 text-sm accent-field accent-focus focus:outline-none w-48"
      >
    </div>
    {% include "components/authorship-filter.njk" %}
  </div>

  <div class="not-prose mb-4 flex flex-wrap items-center gap-1.5">
    <span class="editorial-kicker">Jump to</span>
    {% if collections.pinnedPosts.length > 0 %}
      <a href="#pinned-posts" class="badge badge-accent badge-compact badge-interactive flex items-center gap-1 no-underline">
        {% feather "bookmark", class="w-3 h-3" %} Pinned
      </a>
    {% endif %}
    {% for year in archiveYears %}
      <a href="#year-{{ year }}" class="badge badge-tag badge-compact badge-interactive no-underline">
        {{ year }}
      </a>
    {% endfor %}
  </div>

  <div id="blogList" class="mt-4">
    {% if collections.pinnedPosts.length > 0 %}
      <h2 id="pinned-posts" class="not-prose scroll-mt-20 editorial-kicker py-2 flex items-center gap-1.5">
        {% feather "bookmark", class="w-3.5 h-3.5" %} Pinned
      </h2>
      <ul class="feed-list not-prose list-none m-0 p-0 mb-6">
      {% for post in collections.pinnedPosts %}
        {% set filteredTags = post.data.tags | default([]) | filterTagList %}
        {{ postListRow(post, collections.feed, {
          outerAttrs: 'data-blog-card data-title="' ~ (post.data.title | lower | replace('"', '')) ~ '" data-tags="' ~ (filteredTags | join(' ') | lower) ~ '" data-body="' ~ (post.data.description | default('') | lower | replace('"', '')) ~ '"'
        }) }}
      {% endfor %}
      </ul>
    {% endif %}

    {% for year in archiveYears %}
      <h2 id="year-{{ year }}" class="not-prose scroll-mt-20 editorial-kicker py-2">{{ year }}</h2>
      <ul class="feed-list not-prose list-none m-0 p-0">
      {% for post in collections.posts | sortByDate %}
        {% if not post.data.pinned and (post.date | date("Y")) == year %}
          {% set filteredTags = post.data.tags | default([]) | filterTagList %}
          {{ postListRow(post, collections.feed, {
            outerAttrs: 'data-blog-card data-title="' ~ (post.data.title | lower | replace('"', '')) ~ '" data-tags="' ~ (filteredTags | join(' ') | lower) ~ '" data-body="' ~ (post.data.description | default('') | lower | replace('"', '')) ~ '"'
          }) }}
        {% endif %}
      {% endfor %}
      </ul>
    {% endfor %}
  </div>
</div>

<script>
  const searchInput = document.getElementById('blogSearch');
  const blogCards = Array.from(document.querySelectorAll('[data-blog-card]'));

  searchInput?.addEventListener('input', (e) => {
    const term = e.target.value.trim().toLowerCase();
    blogCards.forEach((card) => {
      const matches = !term || ['title','tags','body'].some(k => (card.dataset[k] || '').includes(term));
      card.closest('article, li').classList.toggle('hidden', !matches);
    });
  });
</script>
