---
layout: layouts/base.njk
title: Status
description: A public health summary for the external data sources that power carteakey.dev.
permalink: /status/
eleventyNavigation:
  key: Status
  order: 20
collectionArchetype: ledger
---
{% include "components/breadcrumbs.njk" %}

{% set pageEyebrow = "Site Health" %}
{% set pageTitle = "Status" %}
{% set pageDescription = "A build-time snapshot of the public data sources used around the site." %}
{% set pageMetaLabel = "Checked" %}
{% set pageMeta = status.checkedAt | readableDate %}
{% include "components/page-header.njk" %}

{% set readingCount = reading.in_progress.length + reading.read.length + reading.want_to_read.length %}
{% set readingState = "warn" %}
{% if readingCount > 0 %}{% set readingState = "ok" %}{% endif %}
{% set letterboxdState = "warn" %}
{% if watching.entries.length > 0 %}{% set letterboxdState = "ok" %}{% endif %}
{% set letterboxdDetail = watching.entries.length ~ " diary entries" %}
{% if watching.entries[0] and watching.entries[0].watched %}
  {% set letterboxdDetail = letterboxdDetail ~ "; latest watched " ~ (watching.entries[0].watched | readableDate) %}
{% endif %}
{% set githubState = "warn" %}
{% if github.repos.length > 0 %}{% set githubState = "ok" %}{% endif %}
{% set githubDetail = github.repos.length ~ " public repos" %}
{% if github.repos[0] and github.repos[0].repo_updated %}
  {% set githubDetail = githubDetail ~ "; latest updated " ~ status.formatDisplayDate(github.repos[0].repo_updated) %}
{% endif %}
{% set contributionsState = "warn" %}
{% if githubContributions.weeks.length > 0 %}{% set contributionsState = "ok" %}{% endif %}
{% set spotifyState = "missing" %}
{% if status.env.spotify %}{% set spotifyState = "ok" %}{% endif %}
{% set steamState = "missing" %}
{% if status.env.steam and steam.length > 0 %}{% set steamState = "ok" %}{% endif %}
{% if status.env.steam and steam.length == 0 %}{% set steamState = "warn" %}{% endif %}
{% set stravaState = "missing" %}
{% if status.env.strava and strava.length > 0 %}{% set stravaState = "ok" %}{% endif %}
{% if status.env.strava and strava.length == 0 %}{% set stravaState = "warn" %}{% endif %}
{% set stravaDetail = strava.length ~ " recent activities" %}
{% if strava[0] and strava[0].start_date %}
  {% set stravaDetail = stravaDetail ~ "; latest " ~ (strava[0].start_date | readableDate) %}
{% endif %}
{% set upstashState = "missing" %}
{% if status.env.upstash %}{% set upstashState = "ok" %}{% endif %}
{% macro statusBadge(state) %}
  {% if state == "ok" %}
    <span class="meta-text text-green-700 dark:text-green-300">OK</span>
  {% elif state == "warn" %}
    <span class="meta-text text-amber-700 dark:text-amber-300">Fallback</span>
  {% elif state == "missing" %}
    <span class="meta-text text-amber-700 dark:text-amber-300">Unavailable</span>
  {% elif state == "error" %}
    <span class="meta-text text-red-700 dark:text-red-300">Error</span>
  {% else %}
    <span class="meta-text text-red-700 dark:text-red-300">Needs config</span>
  {% endif %}
{% endmacro %}

{% macro serviceRow(name, state, detail, href) %}
  <tr class="border-b border-gray-200/70 last:border-0 dark:border-gray-800/80">
    <th scope="row" class="py-3 pr-4 text-left align-top font-semibold text-gray-900 dark:text-gray-100">
      {% if href %}<a href="{{ href }}" class="accent-link">{{ name }}</a>{% else %}{{ name }}{% endif %}
    </th>
    <td class="py-3 pr-4 align-top">{{ statusBadge(state) }}</td>
    <td class="py-3 align-top editorial-support-compact">{{ detail }}</td>
  </tr>
{% endmacro %}

<section class="mt-6 surface surface-padding not-prose">
  <h2 class="editorial-kicker mb-3">Integration Health</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">External service status</caption>
      <thead>
        <tr class="border-b border-gray-300/80 text-left meta-text dark:border-gray-700">
          <th scope="col" class="pb-2 pr-4">Service</th>
          <th scope="col" class="pb-2 pr-4">Status</th>
          <th scope="col" class="pb-2">Current data</th>
        </tr>
      </thead>
      <tbody>
        {{ serviceRow(
          "Goodreads",
          readingState,
          reading.in_progress.length ~ " current, " ~ reading.read.length ~ " read, " ~ reading.want_to_read.length ~ " queued",
          "/reading/"
        ) }}
        {{ serviceRow(
          "Letterboxd",
          letterboxdState,
          letterboxdDetail,
          "/watching/"
        ) }}
        {{ serviceRow(
          "GitHub repos",
          githubState,
          githubDetail,
          "/projects/"
        ) }}
        {{ serviceRow(
          "GitHub contributions",
          contributionsState,
          githubContributions.totalCount ~ " contributions tracked",
          "/projects/"
        ) }}
        {{ serviceRow(
          "Spotify",
          spotifyState,
          spotify.nowPlaying.title ~ " by " ~ spotify.nowPlaying.artist,
          "/listening/"
        ) }}
        {{ serviceRow(
          "Steam",
          steamState,
          steam.length ~ " recent games",
          "/games/"
        ) }}
        {{ serviceRow(
          "Strava",
          stravaState,
          stravaDetail,
          "/workouts/"
        ) }}
        {{ serviceRow(
          "Site counters",
          upstashState,
          (upvotes.posts | length) ~ " post upvote counters; " ~ visitors.total ~ " visitors",
          "/stats/"
        ) }}
      </tbody>
    </table>
  </div>
</section>

{# One halftone dot per recorded build, oldest on the left. Real history from
   .cache/status-builds.json, which Netlify keeps between deploys. #}
{% set history = status.buildHistory | reverse %}
{% set slots = 30 %}
{% set pad = slots - (history | length) %}
<section class="mt-6 surface surface-padding not-prose">
  <h2 class="editorial-kicker mb-1">Recent builds</h2>
  <p class="editorial-support-compact">{{ status.builds.tracked }} builds tracked; {{ status.builds.cleanRate }}% finished without errors. Oldest on the left.</p>
  <svg class="build-strip mt-3" viewBox="0 0 {{ slots * 12 }} 14" role="img" aria-label="Last {{ status.builds.tracked }} builds: {{ status.builds.cleanRate }}% without errors, {{ status.builds.quietRate }}% without warnings">
    {% for n in range(0, pad) %}
      <circle cx="{{ n * 12 + 6 }}" cy="7" r="0.9" fill="currentColor" opacity="0.35"></circle>
    {% endfor %}
    {% for build in history %}
      {% set x = (pad + loop.index0) * 12 + 6 %}
      {% set label = (build.timestamp | readableDate) ~ " · " ~ ((build.durationMs / 1000) | round(1)) ~ " s · " ~ build.warnings ~ " warnings · " ~ build.errors ~ " errors" %}
      {% if build.status != "success" or build.errors > 0 %}
        <circle cx="{{ x }}" cy="7" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"><title>{{ label }}</title></circle>
      {% elif build.warnings > 0 %}
        <circle cx="{{ x }}" cy="7" r="3.4" fill="currentColor"><title>{{ label }}</title></circle>
      {% else %}
        <circle cx="{{ x }}" cy="7" r="5.4" fill="currentColor"><title>{{ label }}</title></circle>
      {% endif %}
    {% endfor %}
  </svg>
  <p class="build-strip-legend mt-2 meta-text">
    <span><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5.4" fill="currentColor"></circle></svg>clean</span>
    <span><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="3.4" fill="currentColor"></circle></svg>warnings</span>
    <span><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle></svg>errors</span>
  </p>
</section>

<p class="mt-3 editorial-support-compact not-prose">Updated during each site build. When a source is unavailable, its page may continue using the last available data.</p>
