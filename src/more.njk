      { path: "/watching/", desc: "Film diary and movie ratings via Letterboxd" },
      { path: "/listening/", desc: "All-time Spotify listening history and stats" },
      { path: "/games/", desc: "Recently played games and hours via Steam" },
      { path: "/workouts/", desc: "Fitness logs, running, and training via Strava" },
      { path: "/gallery/", desc: "Real-world and in-game photography" },
      { path: "/vibes/", desc: "Saved visual fragments, internet finds, and memes" },
      { path: "/quotes/", desc: "Rotating Quote of the Day and memorable lines" },
      { path: "/data/", desc: "My life in data: personal tracking dashboard" }
    ]
  },
  {
    title: "Site & Meta",
    items: [
      { path: "/about/", desc: "Who I am, background, and personal principles" },
