    ]
  }
] %}

{% set totalPages = 0 %}
{% for group in directoryGroups %}
  {% set totalPages = totalPages + group.items.length %}
{% endfor %}

{% set pageEyebrow = "Site Index" %}
{% set pageTitle = "More" %}
{% set pageDescription = "A categorized directory of everything on this site, inspired by <a href=\"https://slashpages.net\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">slashpages.net</a>." %}
{% set itemCount = totalPages %}
{% set itemLabel = "pages" %}
{% include "components/page-header.njk" %}

<div class="space-y-10 not-prose mt-6">
  {% for group in directoryGroups %}
    <section aria-labelledby="section-{{ group.title | slugify }}">
      <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-800 pb-1.5 mb-3">
        <h2 id="section-{{ group.title | slugify }}" class="editorial-kicker">{{ group.title }}</h2>
        <span class="meta-line">{{ group.items.length }} pages</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-1.5">
        {% for item in group.items %}
          <div class="flex items-baseline gap-2 py-0.5 min-w-0">
            <a href="{{ item.path | url }}" class="font-mono text-[0.78rem] font-semibold accent-link shrink-0">{{ item.path }}</a>
            <span class="meta-line text-xs opacity-40 shrink-0">·</span>
            <span class="editorial-support-compact truncate sm:overflow-visible">{{ item.desc }}</span>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
