title: ...More
description: A categorized directory of everything on this site.
permalink: /more/
eleventyNavigation:
  key: ...More
  order: 8
collectionArchetype: index
---

{% set directoryGroups = [
  {
    title: "Read",
    items: [
      { path: "/blog/", desc: "Essays and deep dives" },
      { path: "/notes/", desc: "Short notes and updates" },
      { path: "/snippets/", desc: "Code and config snippets" },
      { path: "/folio/", desc: "Visual essays and obsessions" },
      { path: "/quotations/", desc: "Clippings from things I read" },
      { path: "/feed/", desc: "Everything, newest first" },
      { path: "/tags/", desc: "Browse by topic, incl. TIL and lexicon" }
    ]
  },
  {
    title: "Me",
    items: [
      { path: "/about/", desc: "Who I am" },
      { path: "/now/", desc: "What I'm on right now" },
      { path: "/CARTEAKEY.md", desc: "CLAUDE.md, but for me" },
      { path: "/cv/", desc: "Work history and skills" },
      { path: "/projects/", desc: "Things I've built" },
      { path: "/ai/", desc: "AI stack, prompts and skills" },
      { path: "/uses/", desc: "Software, gear, tools and devices" }
    ]
  },
  {
    title: "Logs",
    items: [
      { path: "/data/", desc: "My life in data" },
      { path: "/reading/", desc: "Books, via Goodreads" },
      { path: "/watching/", desc: "Films, via Letterboxd" },
      { path: "/listening/", desc: "Music, via Spotify" },
      { path: "/games/", desc: "Games, via Steam" },
      { path: "/workouts/", desc: "Training, via Strava" },
      { path: "/gallery/", desc: "Photography" },
      { path: "/vibes/", desc: "Saved images and memes" },
      { path: "/quotes/", desc: "Quote of the day" }
    ]
  },
  {
    title: "Site",
    items: [
      { path: "/colophon/", desc: "How it's built" },
      { path: "/changelog/", desc: "What changed" },
      { path: "/stats/", desc: "Numbers and site health" },
      { path: "/bookmarks/", desc: "Links and blogs I like" },
      { path: "/guestbook/", desc: "Say hi" },
      { path: "/newsletter/", desc: "Weekly digest" },
      { path: "/page-list/", desc: "Every page, flat" }
    ]
  }
] %}

{% set totalPages = 0 %}
{% for group in directoryGroups %}
  {% set totalPages = totalPages + group.items.length %}
{% endfor %}

{% set pageEyebrow = "Site Index" %}
{% set pageTitle = "More" %}
{% set pageDescription = "Everything on this site in one place, inspired by <a href=\"https://slashpages.net\" target=\"_blank\" rel=\"noopener\" class=\"accent-link\">slashpages.net</a>." %}
{% set itemCount = totalPages %}
{% set itemLabel = "pages" %}
{% include "components/page-header.njk" %}

<div class="space-y-10 not-prose mt-6">
  {% for group in directoryGroups %}
    <section aria-labelledby="section-{{ group.title | slugify }}">
      <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-800 pb-1.5 mb-3">
        <h2 id="section-{{ group.title | slugify }}" class="editorial-kicker">{{ group.title }}</h2>
        <span class="meta-line">{{ group.items.length }} pages</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3">
        {% for item in group.items %}
          <div class="flex items-baseline gap-2.5 py-1 min-w-0 border-b border-gray-100 dark:border-gray-900">
            <a href="{{ item.path | url }}" class="font-mono text-[0.85rem] font-semibold accent-link shrink-0" aria-label="{{ item.path }} — {{ item.desc }}">{{ item.path }}</a>
            <span class="meta-line text-xs opacity-40 shrink-0">·</span>
            <span class="editorial-support-compact min-w-0">{{ item.desc }}</span>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
