---
pagination:
  data: fontLab.variants
  size: 1
  alias: variant
permalink: "/lab/fonts/{{ variant.id }}.css"
eleventyExcludeFromCollections: true
---
{%- for pkg in variant.fonts | default([]) %}
@import url("https://cdn.jsdelivr.net/npm/@fontsource/{{ pkg }}@5.3.0/400.css");
@import url("https://cdn.jsdelivr.net/npm/@fontsource/{{ pkg }}@5.3.0/400-italic.css");
@import url("https://cdn.jsdelivr.net/npm/@fontsource/{{ pkg }}@5.3.0/700.css");
{%- endfor %}
/* Font lab variant: {{ variant.label }} */
{{ variant.css | safe }}
