---
layout: layouts/base.njk
title: My life in data
description: A scrollable dashboard generated from cartebase - personal data from Spotify, Apple Photos, and browsing history.
permalink: /data/
eleventyExcludeFromCollections: true
collectionArchetype: ledger
---

{% include "components/breadcrumbs.njk" %}
{% import "components/cartebase-charts.njk" as cb %}

{% set startYear = (cartebase.summary.data_starts_at | split('-'))[0] %}
{% set endYear = (cartebase.summary.data_ends_at | split('-'))[0] %}
{% set topArtist = cartebase.listening.top_artists_all_time[0] %}
{% set topDomain = cartebase.browsing.top_domains_all_time[0] %}
{% set totalMinutes = cartebase.listening.minutes_total %}
{% set peakMonth = cartebase.listening.plays_per_month | sort(true, false, "plays") | first %}
{% set src = "cartebase · " %}

{% set pageTitle = "My life in data" %}
{% set pageMeta = "Updated " ~ (cartebase.summary.last_updated | split('T'))[0] %}
{% set pageDescription = "A scrollable dashboard generated from <a href=\"https://github.com/carteakey/cartebase\" class=\"accent-link\">cartebase</a>, a Dogsheep-style SQLite warehouse of my personal data, spanning <strong>" ~ startYear ~ "–" ~ endYear ~ "</strong>. Inspired by <a href=\"https://howisfelix.today/\" class=\"accent-link\">howisFelix.today</a>. Finance, health, shopping, and private domains are deliberately excluded." %}
{% include "components/page-header.njk" %}

<div class="not-prose grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
  {{ cb.stat_tile("Spotify plays", cartebase.summary.plays_total | localeNumber, "since " + startYear, chartSvg({ type: "spark", data: cartebase.listening.plays_per_month, x: "month", y: "plays" })) }}
  {{ cb.stat_tile("Minutes listened", totalMinutes | round(0) | localeNumber) }}
  {{ cb.stat_tile("Photos", cartebase.summary.photos_total | localeNumber, "", chartSvg({ type: "spark", data: cartebase.photos.photos_per_month, x: "month", y: "count" })) }}
  {{ cb.stat_tile("Browsing visits", cartebase.summary.browsing_visits_total | localeNumber, "", chartSvg({ type: "spark", data: cartebase.browsing.visits_per_month, x: "month", y: "visits" })) }}
</div>

{{ cb.section_header("Music", "Spotify listening history", "music") }}

<div class="not-prose mb-10">
  {{ cb.wrapped_card(
    label="My top artist",
    title=topArtist.artist,
    subtitle="I've played " + topArtist.artist + " more than any other artist - " + (topArtist.share_pct | string) + "% of every track I've streamed.",
    stats=[
      {"label": "Plays", "value": topArtist.plays | localeNumber},
      {"label": "Minutes", "value": topArtist.minutes | round(0) | localeNumber},
      {"label": "Share of all plays", "value": (topArtist.share_pct | string) + "%"}
    ],
    image="/img/radiohead-hero.jpg",
    image_alt="Spotify Wrapped 2025: My Top Artist - Radiohead"
  ) }}
</div>

{% chart {
  type: "line",
  data: cartebase.listening.plays_per_month,
  x: "month",
  y: "plays",
  area: true,
  unit: "plays",
  kicker: "Plays per month",
  title: "Busiest month: " ~ peakMonth.month,
  notes: [{ at: peakMonth.month, text: (peakMonth.plays | localeNumber) ~ " plays", dx: -150, dy: -4 }],
  source: src ~ "spotify_listening_history",
  n: cartebase.listening.plays_total,
  xLabel: "month"
} %}

{% chart {
  type: "multiples",
  labels: cartebase.listening.artist_share_per_year.years,
  series: cartebase.listening.artist_share_per_year.series,
  start: "2019",
  unit: "%",
  digits: 1,
  kicker: "Artist share over time",
  title: "Every artist that cracked a year's top 10, as a share of that year's plays",
  caption: "The long tail (\"Other\") holds the rest and is not drawn. From 2019, since 2016–2018 hold under 50 plays.",
  source: src ~ "spotify_listening_history",
  n: cartebase.listening.plays_total
} %}

{% chart {
  type: "heatmap",
  matrix: cartebase.listening.hour_weekday_heatmap,
  unit: "plays",
  kicker: "Listening rhythm (hour × weekday, UTC)",
  caption: "Bigger dot = more plays. Hours are UTC; local time is America/Toronto (UTC−5/−4).",
  source: src ~ "spotify_listening_history",
  n: cartebase.listening.plays_total
} %}

<p class="editorial-support mt-2 not-prose">
  <a href="/listening/" class="editorial-meta-link">Top albums, tracks, year-in-review → /listening/</a>
</p>

{{ cb.section_header("Web", "Browsing history + bookmarks", "globe") }}

<div class="not-prose mb-8">
  {{ cb.wrapped_card(
    label="Most-visited domain",
    title=topDomain.domain,
    subtitle="Nearly " + (topDomain.share_pct | string) + "% of my recorded web visits land on " + topDomain.domain + ".",
    stats=[
      {"label": "Visits", "value": topDomain.visits | localeNumber},
      {"label": "Share of traffic", "value": (topDomain.share_pct | string) + "%"},
      {"label": "Distinct domains tracked", "value": (cartebase.browsing.top_domains_all_time | length) | string + "+"}
    ]
  ) }}
</div>

{% chart {
  type: "line",
  data: cartebase.browsing.visits_per_month,
  x: "month",
  y: "visits",
  area: true,
  unit: "visits",
  kicker: "Visits per month",
  source: src ~ "browsing_history",
  n: cartebase.summary.browsing_visits_total,
  xLabel: "month"
} %}

{% chart {
  type: "rank",
  data: cartebase.browsing.top_domains_all_time,
  x: "domain",
  y: "visits",
  total: cartebase.summary.browsing_visits_total,
  limit: 10,
  kicker: "Top domains, all time",
  source: src ~ "browsing_history",
  n: cartebase.summary.browsing_visits_total
} %}

{% chart {
  type: "rank",
  data: cartebase.bookmarks.top_domains,
  x: "domain",
  y: "count",
  total: cartebase.summary.bookmarks_total,
  limit: 10,
  kicker: "Bookmarks",
  title: (cartebase.summary.bookmarks_total | localeNumber) ~ " bookmarks, " ~ (cartebase.bookmarks.with_notes_count | localeNumber) ~ " with notes attached",
  caption: "The ones with notes are candidates for the blogmarks feed someday.",
  source: src ~ "bookmarks",
  n: cartebase.summary.bookmarks_total
} %}

{{ cb.section_header("Gaming", "Steam library - " + cartebase.gaming.games_played | string + " of " + cartebase.gaming.games_owned | string + " games actually touched", "monitor") }}

<div class="not-prose grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
  {{ cb.stat_tile("Hours logged", cartebase.gaming.total_hours | round(0) | localeNumber) }}
  {{ cb.stat_tile("Games played", cartebase.gaming.games_played | localeNumber, "of " + cartebase.gaming.games_owned | string + " owned") }}
  {{ cb.stat_tile("Avg / game played", (cartebase.gaming.total_hours / cartebase.gaming.games_played) | round(1) | string + " h") }}
</div>

{% chart {
  type: "rank",
  data: cartebase.gaming.top_games,
  x: "name",
  y: "hours",
  unit: "h",
  total: cartebase.gaming.total_hours,
  limit: 10,
  kicker: "Top games by hours",
  source: src ~ "steam_games",
  n: cartebase.gaming.games_played
} %}

{{ cb.section_header("Photos", "Apple Photos library", "camera") }}

{% chart {
  type: "line",
  data: cartebase.photos.photos_per_month,
  x: "month",
  y: "count",
  area: true,
  unit: "photos",
  kicker: "Photos captured per month",
  source: src ~ "photos_assets",
  n: cartebase.summary.photos_total,
  xLabel: "month"
} %}

{% chart {
  type: "bars",
  data: cartebase.photo_aesthetics.histogram,
  x: "bucket",
  y: "count",
  highlight: "max",
  xTicks: 10,
  kicker: "Apple's aesthetic score, distribution",
  title: "The median photo scores " ~ cartebase.photo_aesthetics.median ~ "; the top 1% start at " ~ cartebase.photo_aesthetics.p99,
  caption: "Camera photos only. Screenshots, and " ~ (cartebase.photo_aesthetics.placeholder_excluded | localeNumber) ~ " unanalysed photos that Photos stores as exactly 0.5, are left out.",
  source: src ~ "photos_assets",
  n: cartebase.photo_aesthetics.photos,
  xLabel: "score bucket",
  yLabel: "photos",
  query: "SELECT overall_aesthetic_score FROM photos_assets WHERE " ~ cartebase.photo_aesthetics.sql.filter ~ " AND COALESCE(is_screenshot, 0) = 0"
} %}

<div class="mt-12 border-t border-gray-200 dark:border-zinc-800/80 pt-8 not-prose">
  <h3 class="editorial-kicker mb-3">About this page</h3>
  <p class="editorial-support mb-3">
    Generated at build time from JSON snapshots exported out of
    <a href="https://github.com/carteakey/cartebase" class="accent-link">cartebase</a>,
    a personal SQLite-for-life data warehouse inspired by
    <a href="https://dogsheep.github.io/" class="accent-link">Simon Willison's Dogsheep</a>
    and <a href="https://howisfelix.today/" class="accent-link">Felix Krause's howisFelix.today</a>.
  </p>
  <p class="editorial-support mb-3">
    Aggregates only - no row-level personal data ships to the web. Portfolio, finance, health,
    and shopping data are deliberately excluded. Browsing history is filtered to drop
    localhost/internal domains and only aggregate counts appear.
  </p>
  <p class="editorial-support">
    A public Datasette instance at <code>datasette.carteakey.dev</code> is a planned follow-up.
  </p>
</div>
