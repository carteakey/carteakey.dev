  "sql": {
    "filter": "media_type = 'photo' AND overall_aesthetic_score IS NOT NULL AND overall_aesthetic_score != 0.5 AND COALESCE(is_hidden, 0) = 0 AND COALESCE(is_trashed, 0) = 0 AND date_created IS NOT NULL",
    "yearly": "SELECT substr(datetime(date_created, COALESCE(timezone_offset_seconds, 0) || ' seconds'), 1, 4) AS year, SUM(COALESCE(is_screenshot, 0) = 0) AS photos, AVG(CASE WHEN COALESCE(is_screenshot, 0) = 0 THEN overall_aesthetic_score END) AS mean, SUM(COALESCE(is_screenshot, 0)) AS screenshots, AVG(overall_aesthetic_score) AS mean_with_screenshots FROM photos_assets WHERE media_type = 'photo' AND overall_aesthetic_score IS NOT NULL AND overall_aesthetic_score != 0.5 AND COALESCE(is_hidden, 0) = 0 AND COALESCE(is_trashed, 0) = 0 AND date_created IS NOT NULL GROUP BY year ORDER BY year",
    "monthly": "SELECT substr(datetime(date_created, COALESCE(timezone_offset_seconds, 0) || ' seconds'), 1, 7) AS month, COUNT(*), AVG(overall_aesthetic_score) FROM photos_assets WHERE media_type = 'photo' AND overall_aesthetic_score IS NOT NULL AND overall_aesthetic_score != 0.5 AND COALESCE(is_hidden, 0) = 0 AND COALESCE(is_trashed, 0) = 0 AND date_created IS NOT NULL AND COALESCE(is_screenshot, 0) = 0 AND datetime(date_created, COALESCE(timezone_offset_seconds, 0) || ' seconds') >= '2022-01-01' GROUP BY month ORDER BY month",
    "month_of_year": "SELECT CAST(substr(datetime(date_created, COALESCE(timezone_offset_seconds, 0) || ' seconds'), 6, 2) AS INTEGER) AS m, COUNT(*), AVG(overall_aesthetic_score), AVG(pleasant_lighting_score) FROM photos_assets WHERE media_type = 'photo' AND overall_aesthetic_score IS NOT NULL AND overall_aesthetic_score != 0.5 AND COALESCE(is_hidden, 0) = 0 AND COALESCE(is_trashed, 0) = 0 AND date_created IS NOT NULL AND COALESCE(is_screenshot, 0) = 0 AND datetime(date_created, COALESCE(timezone_offset_seconds, 0) || ' seconds') >= '2022-01-01' GROUP BY m ORDER BY m"
  }
}
