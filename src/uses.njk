<h1>Uses</h1>
<p class="text-gray-600 dark:text-gray-300 mb-8">
  A living list of the hardware, software, and services I actually use. Inspired by
  <a href="https://uses.tech/" class="accent-link" target="_blank" rel="noopener">uses.tech</a>.
</p>

{# ── Machine snapshots ── #}
<div class="not-prose mb-12 animate-enter stagger-1">
  <div class="flex items-baseline justify-between gap-4 mb-4">
    <h2 class="editorial-title">Machine snapshots</h2>
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Fastfetch + Freeze</span>
  </div>
  <div class="grid gap-6 lg:grid-cols-2">
    {% for machine in uses.machines %}
      <article class="surface rounded-sm overflow-hidden border border-gray-800 bg-[#1e1e1e] dark:bg-[#1a1b26]">
        <div class="flex items-center gap-2 px-3 py-2 bg-[#2d2d2d] dark:bg-[#16161e] border-b border-gray-800">
          <div class="flex gap-1.5 shrink-0" aria-hidden="true">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
          </div>
          <p class="min-w-0 flex-1 truncate text-center font-mono text-[0.65rem] font-semibold text-gray-400">{{ machine.label }}</p>
        </div>
        {% image machine.image, machine.imageAlt, "block w-full h-auto" %}
        <div class="border-t border-gray-800 px-4 py-3 text-[#c0caf5]">
          <h3 class="font-mono text-xs font-semibold">{{ machine.name }}</h3>
          <p class="mt-1 font-mono text-[0.68rem] leading-relaxed text-[#a9b1d6]">{{ machine.description }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{# ── CasaKey homelab ── #}
<section class="not-prose mb-16 animate-enter stagger-2" aria-labelledby="casakey-heading">
  <div class="flex items-baseline justify-between gap-4 mb-4">
    <h2 id="casakey-heading" class="editorial-title">🏠 {{ uses.homelab.name }}</h2>
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Homelab</span>
  </div>
  <p class="editorial-support mb-5">{{ uses.homelab.description }}</p>
  <div class="surface rounded-sm surface-padding">
    <div class="mx-auto mb-6 w-fit border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-3 text-center">
      <p class="font-mono text-xs font-semibold">🕸️ {{ uses.homelab.network.name }}</p>
      <p class="mt-1 font-mono text-[0.65rem] text-gray-600 dark:text-gray-400">{{ uses.homelab.network.description }}</p>
    </div>
    <div class="mb-6 text-center font-mono text-sm text-gray-400 dark:text-gray-500" aria-hidden="true">↓</div>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
      {% for host in uses.homelab.hosts %}
        <article class="border border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-900">
          <p class="font-mono text-xs font-semibold"><span aria-hidden="true">{{ host.emoji }}</span> {{ host.name }}</p>
          <p class="mt-2 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-gray-500 dark:text-gray-400">{{ host.role }}</p>
          <p class="mt-2 editorial-support-compact">{{ host.description }}</p>
        </article>
      {% endfor %}
    </div>
    <div class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2 font-mono text-[0.65rem] text-gray-500 dark:text-gray-400">
      {% for link in uses.homelab.links %}
        <span>{{ link }}</span>
      {% endfor %}
    </div>
  </div>
</section>

{# ── Main categories in multi-column text layout ── #}
<div class="not-prose animate-enter stagger-3">
  <div class="grid md:grid-cols-2 gap-x-12 gap-y-12">
    {% for category in uses.categories %}
      <section>
        <h2 class="editorial-title mb-4 flex items-center gap-2">
          <span>{{ category.emoji }}</span> {{ category.name }}
        </h2>
        <div class="space-y-4">
          {% for item in category.items %}
            <div class="group">
              <div class="flex items-baseline gap-2">
                <span class="opacity-80">{{ item.emoji }}</span>
                {% if item.link %}
                  <a href="{{ item.link }}" target="_blank" rel="noopener" class="editorial-title link-accent decoration-dotted underline-offset-4">{{ item.name }}</a>
                {% else %}
                  <span class="editorial-title">{{ item.name }}</span>
                {% endif %}
              </div>
              {% if item.description %}
                <p class="editorial-support ml-7 mt-1">{{ item.description }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</div>

{# ── Retired section ── #}
<div class="not-prose mt-16 animate-enter stagger-3">
  <h2 class="editorial-title mb-4 flex items-center gap-2">
    <span>🪦</span> Retired
  </h2>
  <div class="grid md:grid-cols-2 gap-x-12 gap-y-4">
    {% for item in uses.retired %}
      <div class="opacity-60 hover:opacity-100 transition-opacity duration-300">
        <div class="flex items-baseline gap-2">
          <span>{{ item.emoji }}</span>
          <span class="editorial-title line-through decoration-1">{{ item.name }}</span>
          <span class="text-xs font-mono bg-gray-200 dark:bg-gray-800 px-1.5 py-0.5 rounded">{{ item.retired_date }}</span>
        </div>
        {% if item.description %}
          <p class="editorial-support-compact ml-7 mt-0.5">{{ item.description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{# ── Changelog section ── #}
<div class="not-prose mt-16 animate-enter stagger-4">
  <h2 class="editorial-title mb-4 flex items-center gap-2">
    <span>📋</span> Changelog
  </h2>
  <div class="surface surface-padding rounded-sm space-y-3">
    {% for entry in uses.changelog %}
      <div class="flex flex-col sm:flex-row gap-1 sm:gap-4 text-sm group">
        <span class="font-mono text-xs text-gray-400 dark:text-gray-500 shrink-0 sm:pt-0.5 sm:w-20">{{ entry.date }}</span>
        <span class="text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors">{{ entry.change }}</span>
      </div>
    {% endfor %}
  </div>
</div>

<div class="mt-12 surface surface-padding rounded-sm not-prose">
  <h3 class="editorial-title mb-2">
    ❓ Want to know more?
  </h3>
  <p class="editorial-support-compact">
    Feel free to <a href="mailto:{{ metadata.author.email }}" class="accent-link">reach out</a> if you have questions about any of these tools or want recommendations for your own setup.
  </p>
</div>
