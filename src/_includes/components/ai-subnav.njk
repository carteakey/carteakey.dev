{% set aiTabs = [
  { label: "AI Workbench", href: "/ai/" },
  { label: "Model Tier List", href: "/folio/model-tier-list/" },
  { label: "Agent Skills", href: "/ai/skills/" },
  { label: "Prompt Library", href: "/ai/prompts/" },
  { label: "Local Rig (yeti-cachy)", href: "/devices/yeti-cachy/" }
] %}
<nav aria-label="AI Ecosystem Navigation" class="not-prose surface surface-compact mb-6 flex flex-wrap items-center justify-between gap-2">
  <span class="editorial-kicker">AI Ecosystem</span>
  <div class="flex flex-wrap items-center gap-3">
    {% for tab in aiTabs %}
      {% set isCurrent = (page.url == tab.href) %}
      <a
        href="{{ tab.href | url }}"
        {% if isCurrent %}aria-current="page"{% endif %}
        class="meta-text no-underline {% if isCurrent %}font-bold border-b-2 border-[color:var(--accent-color)]{% else %}opacity-75 hover:opacity-100 title-hover{% endif %}"
      >{{ tab.label }}</a>
    {% endfor %}
  </div>
</nav>
