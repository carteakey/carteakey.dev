{#
  Shared collection view toggle.

  Usage:
  {% from "components/view-toggle.njk" import viewToggle %}
  {{ viewToggle([
    { value: "stream", label: "Stream view", icon: "activity" },
    { value: "list", label: "List view", icon: "list" },
    { value: "grid", label: "Grid view", icon: "grid" }
  ]) }}

  The parent must expose an Alpine `view` property. Use collectionView() from
  /static/js/collection-views.js when the preference should persist.
#}

{% macro viewToggle(views, model = "view") %}
  <div class="view-toggle" role="group" aria-label="Choose layout">
    {% for option in views %}
      <button
        type="button"
        title="{{ option.label }}"
        aria-label="{{ option.label }}"
        :aria-pressed="{{ model }} === '{{ option.value }}'"
        :class="{ 'active': {{ model }} === '{{ option.value }}' }"
        @click="{{ model }} = '{{ option.value }}'"
      >
        {% feather option.icon, class="w-4 h-4" %}
      </button>
    {% endfor %}
  </div>
{% endmacro %}
