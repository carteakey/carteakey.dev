{% set aboutTabs = [
  { label: "About", href: "/about/" },
  { label: "CV", href: "/cv/" },
  { label: "Uses & Hardware", href: "/uses/" },
  { label: "Life in Data", href: "/data/" },
  { label: "Workouts", href: "/workouts/" },
  { label: "Colophon", href: "/colophon/" }
] %}
<nav aria-label="Profile & Dossier Navigation" class="not-prose surface surface-compact mb-6 flex flex-wrap items-center justify-between gap-2">
  <span class="editorial-kicker">Profile & Dossier</span>
  <div class="flex flex-wrap items-center gap-3">
    {% for tab in aboutTabs %}
      {% set isCurrent = (page.url == tab.href) %}
      <a
        href="{{ tab.href | url }}"
        {% if isCurrent %}aria-current="page"{% endif %}
        class="meta-text no-underline {% if isCurrent %}font-bold border-b-2 border-[color:var(--accent-color)]{% else %}opacity-75 hover:opacity-100 title-hover{% endif %}"
      >{{ tab.label }}</a>
    {% endfor %}
  </div>
</nav>
