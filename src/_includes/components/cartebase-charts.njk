{# Cartebase dashboard tiles and cards. Charts are {% chart %} shortcodes
   (utils/charts.mjs); stat_tile takes an optional sparkline from chartSvg(). #}

{% macro stat_tile(label, value, sublabel="", spark="") %}
<div class="surface surface-compact">
  <div class="text-[0.78rem] uppercase tracking-widest text-gray-400 dark:text-gray-500">{{ label }}</div>
  <div class="text-2xl font-semibold mt-1 text-gray-900 dark:text-gray-100 leading-tight">{{ value }}</div>
  {% if sublabel %}<div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">{{ sublabel }}</div>{% endif %}
  {% if spark %}{{ spark | safe }}{% endif %}
</div>
{% endmacro %}

{% macro section_header(title, sub="", icon="") %}
<div class="flex items-baseline justify-between mt-10 mb-4 not-prose">
  <div class="flex items-center gap-2">
    {% if icon %}<span class="text-gray-400 dark:text-gray-500">{% feather icon, class="w-4 h-4" %}</span>{% endif %}
    <h2 class="editorial-title m-0">{{ title }}</h2>
  </div>
  {% if sub %}<span class="text-xs text-gray-400 dark:text-gray-500">{{ sub }}</span>{% endif %}
</div>
{% endmacro %}

{% macro wrapped_card(label, title, subtitle="", stats=[], size="large", image="", image_alt="") %}
<div class="relative overflow-hidden surface {% if size == 'large' %}p-6 md:p-10{% else %}p-5 md:p-6{% endif %}">
  <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full opacity-10" style="background: var(--accent-color);"></div>
  <div class="relative {% if image %}grid md:grid-cols-[1fr_auto] gap-6 items-center{% endif %}">
    <div>
      <div class="text-[0.78rem] uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mb-3">{{ label }}</div>
      <div class="{% if size == 'large' %}text-4xl md:text-6xl{% else %}text-2xl md:text-4xl{% endif %} font-bold tracking-tight leading-[0.95] mb-3 break-words" style="color: var(--accent-color);">{{ title }}</div>
      {% if subtitle %}<div class="editorial-support-compact mb-4">{{ subtitle }}</div>{% endif %}
      {% if stats | length > 0 %}
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-5 pt-4 border-t border-gray-200 dark:border-zinc-800">
        {% for s in stats %}
        <div>
          <div class="text-[0.78rem] uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-0.5">{{ s.label }}</div>
          <div class="text-base md:text-lg editorial-title">{{ s.value }}</div>
          {% if s.sub %}<div class="text-[0.78rem] text-gray-400 dark:text-gray-500 mt-0.5">{{ s.sub }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% if image %}
    <div class="flex-shrink-0 mx-auto md:mx-0">
      <img src="{{ image }}" alt="{{ image_alt or title }}" class="w-40 md:w-56 h-40 md:h-56 rounded-sm shadow-sm object-cover object-bottom" loading="lazy" />
    </div>
    {% endif %}
  </div>
</div>
{% endmacro %}

{% macro now_playing_strip(track) %}
{% if track %}
<div class="flex items-center gap-3 p-3 surface mb-4">
  {% if track.albumImageUrl %}
    <img src="{{ track.albumImageUrl }}" alt="" class="w-10 h-10 rounded-sm flex-shrink-0" width="40" height="40" loading="lazy">
  {% endif %}
  <div class="min-w-0 flex-1">
    <div class="text-[0.78rem] uppercase tracking-widest" style="color: var(--accent-color);">Now playing</div>
    <div class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{{ track.title }}</div>
    <div class="text-xs text-gray-500 dark:text-gray-400 truncate">{{ track.artist }}</div>
  </div>
  {% if track.songUrl %}
    <a href="{{ track.songUrl }}" target="_blank" rel="noopener" class="editorial-meta-link flex-shrink-0" style="text-decoration:none;">Open →</a>
  {% endif %}
</div>
{% endif %}
{% endmacro %}

{% macro year_card(year, top_artist, top_track, plays, hours, new_artists) %}
<div class="surface surface-compact">
  <div class="flex items-baseline justify-between mb-2">
    <div class="text-xl editorial-title">{{ year }}</div>
    <div class="text-[0.78rem] uppercase tracking-widest text-gray-500 dark:text-gray-400">Year in review</div>
  </div>
  <div class="grid grid-cols-2 gap-2 text-xs mb-3">
    <div><span class="text-gray-500 dark:text-gray-400">Plays</span> <div class="font-medium text-sm">{{ plays }}</div></div>
    <div><span class="text-gray-500 dark:text-gray-400">Hours</span> <div class="font-medium text-sm">{{ hours }}</div></div>
    <div><span class="text-gray-500 dark:text-gray-400">New artists</span> <div class="font-medium text-sm">{{ new_artists }}</div></div>
  </div>
  {% if top_artist %}
    <div class="text-xs text-gray-500 dark:text-gray-400 mt-2">Top artist</div>
    <div class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{{ top_artist.artist }}</div>
    <div class="text-[0.78rem] text-gray-500 dark:text-gray-400">{{ top_artist.plays }} plays</div>
  {% endif %}
  {% if top_track %}
    <div class="text-xs text-gray-500 dark:text-gray-400 mt-2">Top track</div>
    <div class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{{ top_track.track }}</div>
    <div class="text-[0.78rem] text-gray-500 dark:text-gray-400 truncate">{{ top_track.artist }} · {{ top_track.plays }} plays</div>
  {% endif %}
</div>
{% endmacro %}
