<div class="flex flex-wrap items-center gap-1" role="group" aria-label="Filter content by authorship">
  <span class="editorial-kicker mr-1">Authorship</span>
  <button type="button" data-ai-filter-option="all" class="badge badge-filter badge-compact" aria-label="Show all content">All</button>
  <button type="button" data-ai-filter-option="no-generated" class="badge badge-filter badge-compact" aria-label="Hide AI-generated content">Human + Assisted</button>
  <button type="button" data-ai-filter-option="human-only" class="badge badge-filter badge-compact" aria-label="Show only human-written content">Human Only</button>
</div>
