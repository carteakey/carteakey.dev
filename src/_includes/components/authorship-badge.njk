{% macro authorshipBadge(authored_by, compact=false, kind="writing") %}
  {% if authored_by == 'human' %}
    {% set icon = "edit-2" %}
    {% set label = "Human" %}
    {% set title = "Human - Written without AI assistance" %}
    {% if kind == "project" %}{% set title = "Human - Built without AI assistance" %}{% endif %}
  {% elif authored_by == 'ai-assisted' %}
    {% set icon = "zap" %}
    {% set label = "AI Assisted" %}
    {% set title = "AI Assisted - Written with AI as a creative partner" %}
    {% if kind == "project" %}{% set title = "AI Assisted - Built with AI as a pairing partner; I direct and review the code" %}{% endif %}
  {% elif authored_by == 'ai-generated' %}
    {% set icon = "cpu" %}
    {% set label = "AI Generated" %}
    {% set title = "AI Generated - Primarily created by AI with human oversight" %}
    {% if kind == "project" %}{% set title = "AI Generated - Most of the code was written by an agent; I specify, test and review" %}{% endif %}
  {% else %}
    {% set icon = "help-circle" %}
    {% set label = "Unclassified" %}
    {% set title = "Unclassified - Authorship not yet tagged" %}
  {% endif %}

  {% if compact %}
    <span class="authorship-badge-compact badge badge-compact badge-status inline-flex items-center justify-center w-fit flex-none align-middle" data-tooltip="{{ title }}">
      {% feather icon, class="w-2.5 h-2.5" %}
    </span>
  {% else %}
    <span class="badge badge-compact badge-status inline-flex items-center gap-0.5 align-middle" title="{{ title }}">
      {% feather icon, class="w-2.5 h-2.5 inline" %} {{ label }}
    </span>
  {% endif %}
{% endmacro %}
