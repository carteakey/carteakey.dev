{% from "components/authorship-badge.njk" import authorshipBadge %}
{% macro feedCard(item, options) %}
  {% set opts = options or {} %}
  {% set variant = opts.variant or 'full' %}
  {% set showSummary = true %}
  {% set extraClasses = (opts.extraClasses or '') | trim %}
  {% set outerAttrs = (opts.outerAttrs or '') | trim %}
  {% if opts.showSummary is defined %}
    {% set showSummary = opts.showSummary %}
  {% endif %}

  {% set showTags = true %}
  {% if opts.showTags is defined %}
    {% set showTags = opts.showTags %}
  {% endif %}

  {% set itemImage = item.image %}
  {% set itemImageAlt = item.imageAlt or item.title or '' %}

  {% set isNote = item.type == 'note' %}
  {% set isSnippet = item.type == 'snippet' %}
  {% set isPhoto = item.type == 'photo' %}
  {% set isVibe = item.type == 'vibe' %}
  {% set isNow = item.type == 'now' %}
  {% set isTil = item.type == 'til' %}
  {% set isFolio = item.type == 'folio' %}
  {% set isQuotation = item.type == 'quotation' %}
  {% set isLexicon = item.type == 'lexicon' %}
  {% set isTool = item.type == 'tool' %}

  {% set badgeLabel = "Update" %}
  {% set typeBadgeClass = "badge-type-default" %}
  {% if item.type == 'post' %}
    {% set badgeLabel = "Post" %}
    {% set typeBadgeClass = "badge-type-post" %}
  {% elif isSnippet %}
    {% set badgeLabel = "Snippet" %}
    {% set typeBadgeClass = "badge-type-snippet" %}
  {% elif isNote %}
    {% set badgeLabel = "Note" %}
    {% set typeBadgeClass = "badge-type-note" %}
  {% elif isPhoto %}
    {% set badgeLabel = "Photo" %}
    {% set typeBadgeClass = "badge-type-photo" %}
  {% elif isVibe %}
    {% set badgeLabel = "Vibe" %}
    {% set typeBadgeClass = "badge-type-vibe" %}
  {% elif isNow %}
    {% set badgeLabel = "Now" %}
    {% set typeBadgeClass = "badge-type-now" %}
  {% elif isTil %}
    {% set badgeLabel = "TIL" %}
    {% set typeBadgeClass = "badge-type-til" %}
  {% elif isFolio %}
    {% set badgeLabel = "Folio" %}
    {% set typeBadgeClass = "badge-type-folio" %}
  {% elif isQuotation %}
    {% set badgeLabel = "Quotation" %}
    {% set typeBadgeClass = "badge-type-quotation" %}
  {% elif isLexicon %}
    {% set badgeLabel = "Lexicon" %}
    {% set typeBadgeClass = "badge-type-lexicon" %}
  {% elif isTool %}
    {% set badgeLabel = "Tool" %}
    {% set typeBadgeClass = "badge-type-tool" %}
  {% endif %}

  {# ── LIST VARIANT (Writing index & homepage preview - single compact row) ── #}
  {% if variant == 'list' %}
  <li class="feed-list-row{% if opts.rich %} feed-list-row-thumb{% endif %}{% if extraClasses %} {{ extraClasses }}{% endif %}" {% if item.authored_by %}data-authored-by="{{ item.authored_by }}" {% endif %}{% if outerAttrs %}{{ outerAttrs | safe }}{% endif %}>
    <span class="feed-list-date meta-text">{{ (opts.date or item.date) | shortDate }}</span>
    {% if opts.rich %}<span class="hidden sm:block w-11 h-11">{% if item.imageMetadata %}<a href="{{ item.url | url }}" class="no-underline">{% post_thumbnail_markup item.imageMetadata, itemImageAlt, "stamp-cobalt block h-11 w-11 object-contain", 44 %}</a>{% endif %}</span>{% endif %}
    <div>
    {% if item.url %}
      <a href="{{ item.url | url }}" class="feed-list-title title-hover">{% if item.featured %}<span class="mr-1.5 text-[color:var(--accent-color)]" title="Featured" aria-label="Featured">★</span>{% endif %}{% if item.pinned %}<span class="inline-flex items-center mr-1.5 -mt-0.5 text-[color:var(--accent-color)]" title="Pinned" aria-label="Pinned">{% feather "bookmark", class="w-3.5 h-3.5 fill-current" %}</span>{% endif %}{{ item.title }}</a>
    {% else %}
      <span class="feed-list-title">{% if item.featured %}<span class="mr-1.5 text-[color:var(--accent-color)]" title="Featured" aria-label="Featured">★</span>{% endif %}{% if item.pinned %}<span class="inline-flex items-center mr-1.5 -mt-0.5 text-[color:var(--accent-color)]" title="Pinned" aria-label="Pinned">{% feather "bookmark", class="w-3.5 h-3.5 fill-current" %}</span>{% endif %}{{ item.title }}</span>
    {% endif %}
    {% if (opts.rich or opts.showSummary) and item.summary %}<p class="feed-list-desc">{{ item.summary }}</p>{% endif %}
    </div>
    <div class="flex items-center gap-1.5 shrink-0 justify-end">
      {% if item.featured %}
        <span class="badge badge-featured badge-compact" title="Featured" aria-label="Featured">★ Featured</span>
      {% endif %}
      {% if (opts.rich or opts.showTags) %}{% for tag in item.tags | default([]) | filterTagList %}<a href="/tags/{{ tag | slugify }}/" class="badge badge-tag badge-compact badge-interactive hidden md:inline-flex no-underline">#{{ tag }}</a>{% endfor %}{% endif %}
      {% if opts.showType is not defined or opts.showType %}<span class="badge badge-type badge-compact {{ typeBadgeClass }}">{{ badgeLabel }}</span>{% endif %}
      {% if item.hidden %}
        <span class="badge badge-accent badge-compact" title="Hidden local preview">Hidden</span>
      {% endif %}
      {% if item.authored_by is defined %}{{ authorshipBadge(item.authored_by, compact=true) }}{% endif %}
    </div>
  </li>

  {# ── STREAM VARIANT (Notes & Lexicon) ── #}
  {% elif variant == 'stream' %}
  <article {% if item.original and item.original.fileSlug %}id="{{ item.original.fileSlug }}" {% endif %}class="feed-card-stream{% if extraClasses %} {{ extraClasses }}{% endif %} group py-1.5" {% if item.authored_by %}data-authored-by="{{ item.authored_by }}" {% endif %}{% if outerAttrs %}{{ outerAttrs | safe }}{% endif %}>
    <div class="flex flex-col md:flex-row md:gap-8">
      {# Left column: Date & Type #}
      <div class="shrink-0 md:w-28 pt-1 flex flex-row md:flex-col gap-3 md:gap-1.5 items-center md:items-start mb-3 md:mb-0">
        <time class="meta-line" datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
        
        <div class="flex items-center gap-1.5 md:mt-0.5">
          <span class="badge badge-type badge-compact {{ typeBadgeClass }}">{{ badgeLabel }}</span>
          {% if item.hidden %}
            <span class="badge badge-accent badge-compact" title="Hidden local preview">Hidden</span>
          {% endif %}
        </div>
        
        <a href="{{ item.url | url }}" class="hidden md:inline-block mt-2 editorial-meta-link no-underline">Permalink →</a>
      </div>

      {# Right column: Content #}
      <div class="flex-1 min-w-0 border-b border-gray-100 dark:border-gray-800/80 pb-4 group-last:border-0 group-last:pb-0">
        {# Title (for posts, tils, snippets, notes) #}
        {% if not (isQuotation or isVibe or isPhoto or isNow) %}
          <div class="leading-snug mb-1.5 flex items-center flex-wrap gap-2">
            {% if item.pinned %}
              <span class="badge badge-accent badge-compact flex items-center gap-1" title="Pinned" aria-label="Pinned">{% feather "bookmark", class="w-3 h-3" %} Pinned</span>
            {% endif %}
            {% if item.featured %}
              <span class="badge badge-featured badge-compact" title="Featured" aria-label="Featured">★ Featured</span>
            {% endif %}
            {% if item.authored_by is defined %}{{ authorshipBadge(item.authored_by, compact=true) }}{% endif %}
            {% if item.title %}
              {% if item.url %}
                <a href="{{ item.url | url }}" class="editorial-title-link title-hover no-underline">
                  {{ item.title }}
                </a>
              {% else %}
                <span class="editorial-title">
                  {{ item.title }}
                </span>
              {% endif %}
            {% endif %}
          </div>
        {% else %}
          {% if item.pinned or item.featured or item.authored_by is defined %}
          <div class="flex items-center gap-2 mb-1.5">
            {% if item.pinned %}
              <span class="badge badge-accent badge-compact flex items-center gap-1">{% feather "bookmark", class="w-3 h-3" %} Pinned</span>
            {% endif %}
            {% if item.featured %}
              <span class="badge badge-featured badge-compact">★ Featured</span>
            {% endif %}
            {% if item.authored_by is defined %}{{ authorshipBadge(item.authored_by, compact=true) }}{% endif %}
          </div>
          {% endif %}
        {% endif %}

        {# Body Content #}
        <div class="editorial-support-compact leading-relaxed site-content prose-sm max-w-none [&_img]:max-h-72 [&_img]:w-auto [&_img]:max-w-full [&_img]:object-contain">
          {% if isNote or isNow or isTil or isLexicon %}
            <div x-data="{ expanded: false, isOverflowing: false }"
                 x-init="const measure = () => { if ($refs.content) isOverflowing = $refs.content.scrollHeight > 360; }; setTimeout(measure, 50); $refs.content.querySelectorAll('img').forEach(i => { if (!i.complete) i.addEventListener('load', measure, { once: true }); })">
              <div x-ref="content" :class="!expanded && isOverflowing ? 'max-h-[20rem] overflow-hidden relative' : ''">
                {{ item.original.templateContent | safe }}
                <div x-show="!expanded && isOverflowing" class="feed-surface-note-fade absolute bottom-0 left-0 right-0 h-24 pointer-events-none"></div>
              </div>
              <div x-show="isOverflowing" class="mt-2" x-cloak>
                <button type="button" @click="expanded = !expanded" class="meta-line text-[color:var(--accent-color)] hover:underline focus:outline-none">
                  <span x-show="!expanded">Read full {% if isNote %}note{% elif isNow %}update{% elif isTil %}TIL{% else %}entry{% endif %} &darr;</span>
                  <span x-show="expanded">Show less &uarr;</span>
                </button>
              </div>
            </div>
            {% if item.original.data.author or item.original.data.source %}
            <div class="mt-3 flex flex-col">
              {% if item.original.data.author %}
              <span class="editorial-title-sm">
                - {% if item.original.data.authorUrl %}<a href="{{ item.original.data.authorUrl }}" target="_blank" rel="noopener" class="hover:text-[color:var(--accent-color)] transition-colors">{{ item.original.data.author }}</a>{% else %}{{ item.original.data.author }}{% endif %}
              </span>
              {% endif %}
              {% if item.original.data.source %}
              <span class="meta-line mt-0.5">
                {% if item.original.data.sourceUrl %}
                  <a href="{{ item.original.data.sourceUrl }}" target="_blank" rel="noopener" class="hover:text-[color:var(--accent-color)] transition-colors">{{ item.original.data.source }}</a>
                {% else %}
                  {{ item.original.data.source }}
                {% endif %}
              </span>
              {% endif %}
            </div>
            {% endif %}
          {% elif isQuotation %}
            <div class="italic border-l-2 border-[color:var(--accent-color)] pl-4 py-0.5 m-0 relative">
              <div class="relative z-10">{{ item.original.templateContent | safe }}</div>
            </div>
            <div class="mt-3 flex flex-col gap-3">
              <div class="flex flex-col">
                <span class="editorial-title-sm">
                  - {% if item.original.data.authorUrl %}<a href="{{ item.original.data.authorUrl }}" target="_blank" rel="noopener" class="hover:underline">{{ item.original.data.author }}</a>{% else %}{{ item.original.data.author }}{% endif %}
                </span>
                {% if item.original.data.source %}
                  <span class="meta-line mt-0.5">
                    {% if item.original.data.sourceUrl %}
                      <a href="{{ item.original.data.sourceUrl }}" target="_blank" rel="noopener" class="hover:underline">{{ item.original.data.source }}</a>
                    {% else %}
                      {{ item.original.data.source }}
                    {% endif %}
                  </span>
                {% endif %}
              </div>
            </div>
          {% elif isPhoto or isVibe or item.media %}
            <figure class="m-0 overflow-hidden border border-gray-200 dark:border-gray-700 not-prose">
              <img src="{{ item.media.src }}" alt="{{ item.media.alt }}" loading="lazy" decoding="async" class="w-full h-auto block m-0">
              {% if item.summary %}
                <figcaption class="px-3 py-2 meta-line bg-gray-50 dark:bg-gray-800/50 border-t border-gray-200 dark:border-gray-700 m-0">{{ item.summary }}</figcaption>
              {% endif %}
            </figure>
          {% elif item.type == 'post' or isSnippet %}
            <div class="{% if itemImage and item.type == 'post' %}flex items-start gap-3{% endif %}">
              <div class="min-w-0 flex-1">
                {% if item.summary %}
                  <p class="mt-0 mb-1.5 editorial-support">{{ item.summary }}</p>
                {% endif %}
                {% if item.original.templateContent %}
                  {% set previewText = item.original.templateContent | striptags | truncate(300) %}
                  {% if previewText and not item.summary %}
                    <p class="mt-0 editorial-support-compact">{{ previewText | safe }}</p>
                  {% endif %}
                {% endif %}
                {% if isSnippet %}
                <div class="mt-1.5">
                  <a href="{{ item.url | url }}" class="meta-line text-[color:var(--accent-color)] no-underline hover:underline">View Snippet &rarr;</a>
                </div>
                {% endif %}
              </div>
              {% if itemImage and item.type == 'post' %}
                <a href="{{ item.url | url }}" class="hidden sm:block shrink-0 no-underline">
                  {% post_thumbnail_markup item.imageMetadata, itemImageAlt, "stamp-cobalt block h-16 w-16 object-contain", 64 %}
                </a>
              {% endif %}
            </div>
          {% else %}
            {% if item.summary %}
              <p class="mt-0">{{ item.summary }}</p>
            {% endif %}
          {% endif %}
        </div>

        {# Tags #}
        {% if showTags and item.tags %}
          <div class="flex flex-wrap gap-1.5 mt-2 not-prose">
            {% for tag in item.tags %}
              {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
              {% if item.type == 'tool' %}
                <span class="badge badge-tag badge-compact">#{{ tag }}</span>
              {% else %}
                <a href="{{ tagUrl | url }}" class="badge badge-tag badge-compact badge-interactive no-underline">#{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </article>

  {# ── FULL VARIANT (masonry feed card) ── #}
  {% else %}
  <article class="feed-card surface surface-compact feed-card-full{% if extraClasses %} {{ extraClasses }}{% endif %}" {% if item.authored_by %}data-authored-by="{{ item.authored_by }}" {% endif %}{% if outerAttrs %}{{ outerAttrs | safe }}{% endif %}>
    <div class="flex items-center gap-2 mb-2.5">
      {% if opts.showType is not defined or opts.showType %}<span class="badge badge-type badge-compact {{ typeBadgeClass }}">{{ badgeLabel }}</span>{% endif %}
      {% if item.hidden %}
        <span class="badge badge-accent badge-compact" title="Hidden local preview">Hidden</span>
      {% endif %}
      {% if item.featured %}
        <span class="badge badge-featured badge-compact" title="Featured" aria-label="Featured">★ Featured</span>
      {% endif %}
      {% if item.pinned %}
        <span class="badge badge-accent badge-compact flex items-center gap-1" title="Pinned" aria-label="Pinned">{% feather "bookmark", class="w-3 h-3" %} Pinned</span>
      {% endif %}
      {% if item.authored_by is defined %}{{ authorshipBadge(item.authored_by, compact=true) }}{% endif %}
      <time datetime="{{ item.date | htmlDateString }}" class="meta-line ml-auto">{{ item.date | readableDate }}</time>
    </div>

    {% if not isQuotation %}
    <h3 class="editorial-title-compact m-0">
      {% if item.url %}
        <a href="{{ item.url | url }}" class="title-hover no-underline">{{ item.title }}</a>
      {% else %}
        {{ item.title }}
      {% endif %}
    </h3>
    {% endif %}

    {% if isNote or isNow or isQuotation or isLexicon %}
      {% set contentToRender = item.original.templateContent %}
      {% if contentToRender %}
        {% if isQuotation %}
          <div class="relative mt-2 max-h-44 overflow-hidden">
            <div class="italic border-l-2 border-[color:var(--accent-color)] pl-3 py-0.5 relative editorial-support-compact max-w-none not-prose">
              <div class="relative z-10">{{ contentToRender | safe }}</div>
            </div>
            <div class="feed-surface-note-fade absolute bottom-0 left-0 right-0 h-8 pointer-events-none"></div>
          </div>
          <div class="flex flex-col mt-2 shrink-0">
            <span class="editorial-title-sm">
              - {% if item.original.data.authorUrl %}<a href="{{ item.original.data.authorUrl }}" target="_blank" rel="noopener" class="hover:underline">{{ item.original.data.author }}</a>{% else %}{{ item.original.data.author }}{% endif %}
            </span>
            {% if item.original.data.source %}
              <span class="meta-line mt-0.5">
                {% if item.original.data.sourceUrl %}
                  <a href="{{ item.original.data.sourceUrl }}" target="_blank" rel="noopener" class="hover:underline no-underline">{{ item.original.data.source }}</a>
                {% else %}
                  {{ item.original.data.source }}
                {% endif %}
              </span>
            {% endif %}
          </div>
        {% else %}
          <div class="feed-clamp relative mt-2">
            <div class="editorial-support-compact max-w-none not-prose">{{ contentToRender | safe }}</div>
            <div class="feed-surface-note-fade absolute bottom-0 left-0 right-0 h-10 pointer-events-none"></div>
          </div>
          {% if item.original.data.author or item.original.data.source %}
          <div class="flex flex-col mt-2 shrink-0">
            {% if item.original.data.author %}
            <span class="editorial-title-sm">
              - {% if item.original.data.authorUrl %}<a href="{{ item.original.data.authorUrl }}" target="_blank" rel="noopener" class="hover:text-[color:var(--accent-color)] transition-colors">{{ item.original.data.author }}</a>{% else %}{{ item.original.data.author }}{% endif %}
            </span>
            {% endif %}
            {% if item.original.data.source %}
            <span class="meta-line mt-0.5">
              {% if item.original.data.sourceUrl %}
                <a href="{{ item.original.data.sourceUrl }}" target="_blank" rel="noopener" class="hover:text-[color:var(--accent-color)] transition-colors no-underline">{{ item.original.data.source }}</a>
              {% else %}
                {{ item.original.data.source }}
              {% endif %}
            </span>
            {% endif %}
          </div>
          {% endif %}
        {% endif %}
      {% elif item.summary %}
        <p class="mt-1.5 editorial-support-compact m-0">{{ item.summary }}</p>
      {% endif %}
    {% elif item.media %}
      <figure class="mt-2 overflow-hidden border border-gray-200 dark:border-gray-700 m-0">
        <img src="{{ item.media.src }}" alt="{{ item.media.alt }}" loading="lazy" decoding="async" class="w-full h-auto block">
        {% if item.summary %}
          <figcaption class="px-2 py-1 meta-line">{{ item.summary }}</figcaption>
        {% endif %}
      </figure>
    {% elif item.summary and showSummary %}
      {% if itemImage and item.type == 'post' %}
        <div class="mt-2 flex items-start gap-3">
          <p class="min-w-0 flex-1 editorial-support-compact m-0">{{ item.summary }}</p>
          <a href="{{ item.url | url }}" class="shrink-0 no-underline">
            {% post_thumbnail_markup item.imageMetadata, itemImageAlt, "stamp-cobalt block h-16 w-16 object-contain", 64 %}
          </a>
        </div>
      {% else %}
        <p class="mt-1.5 editorial-support-compact m-0">{{ item.summary }}</p>
      {% endif %}
    {% endif %}

    {% if showTags and item.tags %}
      <div class="flex flex-wrap gap-1 mt-2.5">
        {% for tag in item.tags %}
          {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
          {% if item.type == 'tool' %}
            <span class="badge badge-tag badge-compact">#{{ tag }}</span>
          {% else %}
            <a href="{{ tagUrl | url }}" class="badge badge-tag badge-compact badge-interactive no-underline">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </article>
  {% endif %}
{% endmacro %}

{# Row for a raw Eleventy post (Writing, folder, tag pages): resolves the flat feed item so every list renders through feedCard. #}
{% macro postListRow(post, feed, extra) %}
  {% for item in feed %}{% if item.url == post.url %}
    {{ feedCard(item, {
      variant: 'list',
      rich: true,
      showType: false,
      date: post.date,
      extraClasses: (extra.extraClasses or '') ~ ((' postlist-item-active') if extra.active else ''),
      outerAttrs: extra.outerAttrs
    }) }}
  {% endif %}{% endfor %}
{% endmacro %}
