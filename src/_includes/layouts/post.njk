---
layout: layouts/base.njk
templateClass: tmpl-post
hasEthicalAds: false
---

{# JSON-LD Structured Data for Blog Posts #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ (seoDescription or description) | dump | safe }},
  "image": {% if image %}"{{ image | absoluteUrl(metadata.url) }}"{% else %}"{{ '/img/avatar.png' | absoluteUrl(metadata.url) }}"{% endif %},
  "datePublished": "{{ page.date | htmlDateString }}",
  {% if updated %}"dateModified": "{{ updated | htmlDateString }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ metadata.author.name }}",
    "url": "{{ metadata.author.url }}"
  },
  "publisher": {
    "@type": "Person",
    "name": "{{ metadata.author.name }}",
    "url": "{{ metadata.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ page.url | absoluteUrl(metadata.url) }}"
  },
  "keywords": {{ tags | filterTagList | join(', ') | dump | safe }},
  "wordCount": {{ content | wordCount }},
  "timeRequired": "{{ content | isoReadingDuration }}",
  "articleBody": {{ content | excerptWords(300) | dump | safe }}
}
</script>

{% include "components/breadcrumbs.njk" %}
{% from "components/comment-pointer.njk" import commentPointer %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

{% set isDraft = hidden or draft or (title and (title | lower).includes('draft')) %}

{% set showSidebar = not fullWidth %}
{% set tocHtml = (content | toc) | default('') %}
{% set conversationPlacement = conversationPlacement or 'sidebar' %}
{% set isEditorial = (theme == 'editorial') %}
{% set edPair = pair or 'teal-rose' %}

<div class="reading-progress" aria-hidden="true"><div id="readingProgressBar" class="reading-progress-bar"></div></div>

<div class="post-wrap relative"{% if isEditorial %} data-pair="{{ edPair }}"{% endif %}>
  {# Left Gutter Rail - reserved for editorial meta-sidebar or sidenotes; no redundant author bio box #}
  {% if showSidebar and isEditorial and sidebar %}
  <aside class="hidden xl:block post-rail post-rail-left">
    <div class="post-rail-inner sticky top-24 space-y-4">
      {% include "components/editorial-sidebar.njk" %}
    </div>
  </aside>
  {% endif %}

  {# Right Sidebar - Sticky Outline & Comment Pointer #}
  {% if showSidebar %}
  <aside class="hidden xl:block post-rail post-rail-right">
    <div class="post-rail-inner sticky top-24 space-y-4">
      {% if tocHtml | trim %}
      <section class="surface surface-padding">
        <p class="post-panel-title flex items-center gap-2">
          {% feather "list", class="w-4 h-4 opacity-70" %}
          Outline
        </p>
        <div class="toc-list mt-3 max-h-[60vh] overflow-y-auto pr-1 space-y-2">
          {{ tocHtml | safe }}
        </div>
      </section>
      {% endif %}
      {% if conversationPlacement != 'inline' and conversationPlacement != 'none' %}
        {{ commentPointer({ variant: 'sidebar' }) | safe }}
      {% endif %}
    </div>
  </aside>
  {% endif %}

  <article class="post-shell min-w-0 space-y-4 px-4 sm:px-5 xl:px-0 animate-enter">
    <header class="post-header space-y-2.5">
      {% set primaryTag = (tags | filterTagList)[0] %}
      {% if primaryTag %}
        <p class="post-title-eyebrow">[{{ primaryTag }}]</p>
      {% endif %}
      <h1 class="post-title">{{ title }}</h1>

      {% if description %}
        <p class="post-dek">{{ description }}</p>
      {% endif %}

      {# Single Monospace Metadata Ledger Bar #}
      <div class="post-meta-row not-prose pt-1">
        <div class="post-meta-primary">
          <time datetime="{{ page.date | htmlDateString }}" class="post-meta-chip">
            {% feather "calendar", class="w-3.5 h-3.5 opacity-60" %}
            {{ page.date | readableDate }}
          </time>
          {% if updated %}
            <span class="post-meta-chip">
              · Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time>
            </span>
          {% endif %}
          <span class="post-meta-chip">
            {% feather "clock", class="w-3.5 h-3.5 opacity-60" %}
            {{ content | readingTime }}
          </span>
          {{ authorshipBadge(authored_by) }}
          {% set visibleTags = tags | filterTagList %}
          {% for tag in visibleTags %}
            {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
            <a href="{{ tagUrl | url }}" class="badge badge-tag badge-compact badge-interactive no-underline">
              #{{ tag }}
            </a>
          {% endfor %}
        </div>

        <div class="post-meta-secondary">
          {% include "components/copy-markdown.njk" %}
        </div>
      </div>

      {% if isDraft %}
      <div class="surface surface-compact not-prose">
        <div class="post-status-copy">
          {% if hidden %}
          <span class="post-status-label">Hidden local preview:</span> This page has <code>hidden: true</code>. It is rendered only in local/dev builds and is excluded from production output.
          {% else %}
          <span class="post-status-label">Draft:</span> This post is a work in progress - it may be incomplete or change. I publish drafts early because it's less stressful than waiting for perfect.
          {% endif %}
        </div>
      </div>
      {% endif %}

      {% if authored_by == 'ai-assisted' or authored_by == 'ai-generated' %}
      <details class="not-prose surface surface-compact">
        <summary class="meta-text cursor-pointer select-none flex items-center gap-1.5">
          {% feather "zap", class="w-3.5 h-3.5 opacity-70" %}
          <span>{% if authored_by == 'ai-assisted' %}AI-Assisted authorship note{% else %}AI-Generated authorship note{% endif %}</span>
        </summary>
        <p class="editorial-support-compact mt-2 mb-0">
          {% if authored_by == 'ai-assisted' %}
            Written with AI as a creative partner. AI helped with research, drafting, or wording; I edited and verified the result. Credits for source ideas and adapted material are listed separately.
          {% else %}
            AI wrote most of the words here. I selected, structured, and edited the material. Credits for source ideas and adapted material are listed separately.
          {% endif %}
        </p>
      </details>
      {% endif %}

      {% if image %}
        <figure class="not-prose mt-2 flex justify-center">
          <img
            src="{{ image | url }}"
            alt="{{ imageAlt or title }}"
            loading="eager"
            decoding="async"
            class="stamp-cobalt block h-auto max-h-[18rem] w-auto max-w-full object-contain"
          >
        </figure>
      {% endif %}
    </header>

    <hr class="divider-gradient" />

    {# Mobile / Tablet Table of Contents (placed before the prose rather than below comments) #}
    {% if tocHtml | trim %}
    <details class="not-prose surface surface-compact xl:hidden my-3">
      <summary class="post-panel-title cursor-pointer select-none flex items-center gap-2">
        {% feather "list", class="w-4 h-4 opacity-70" %}
        <span>Outline</span>
      </summary>
      <div class="toc-list mt-3 max-h-[45vh] overflow-y-auto pr-1 space-y-1.5">
        {{ tocHtml | safe }}
      </div>
    </details>
    {% endif %}

    {% if attribution %}
      <aside class="surface surface-padding not-prose" aria-label="Source attribution">
        <h2 class="post-panel-title">{{ attribution.title }}</h2>
        <p class="editorial-support mt-2">{{ attribution.text }}</p>
        <p class="editorial-support-compact mt-2"><a href="{{ attribution.url }}" class="accent-link">{{ attribution.titleOfWork }}</a> by {{ attribution.author }}</p>
      </aside>
    {% endif %}

    <div class="post-body{% if isEditorial %} ed-prose{% endif %}">
      {{ content | safe }}
    </div>

    {% if sources and sources.length %}
      <section class="surface surface-padding not-prose" aria-labelledby="post-sources-title">
        <h2 id="post-sources-title" class="post-panel-title">Sources and acknowledgements</h2>
        <ul class="space-y-3 mt-3 list-none m-0 p-0">
          {% for reference in sources %}
            <li>
              <p class="editorial-support m-0"><a href="{{ reference.url }}" class="accent-link">{{ reference.title }}</a>{% if reference.author %} · {{ reference.author }}{% endif %}</p>
              {% if reference.contribution %}<p class="editorial-support-compact m-0 mt-0.5">{{ reference.contribution }}</p>{% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {# Quiet End-of-Post Upvote Bar #}
    <div class="upvote-section not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800 flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-2">
        <button id="upvoteButton" class="upvote-button post-action-button" aria-label="Upvote this post" aria-busy="false">
          {% feather "thumbs-up", class="w-4 h-4 opacity-75" %}
          <span id="upvoteCount" class="meta-text font-semibold">
            {{ upvotes.posts[page.fileSlug] | default(0) }}
          </span>
          <span id="upvoteLoading" class="hidden">
            <span class="inline-block animate-spin h-3.5 w-3.5 border-b-2 border-[color:var(--accent-color)]"></span>
          </span>
        </button>
        <span id="upvoteMessage" class="editorial-support-compact hidden">Thanks for the upvote.</span>
      </div>
      {% include "components/copy-markdown.njk" %}
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', async function() {
        const upvoteButton = document.getElementById('upvoteButton');
        const upvoteCount = document.getElementById('upvoteCount');
        const upvoteMessage = document.getElementById('upvoteMessage');
        const upvoteLoading = document.getElementById('upvoteLoading');
        const postSlug = '{{ page.fileSlug }}';
        const storageKey = `upvote_${postSlug}`;
        const viewStorageKey = `viewed_${postSlug}`;
        const hasViewed = sessionStorage.getItem(viewStorageKey) === 'true';

        async function fetchCounts(trackView = false) {
          try {
            upvoteButton.setAttribute('aria-busy', 'true');
            upvoteLoading.classList.remove('hidden');
            upvoteCount.classList.add('opacity-50');
            const url = `/.netlify/functions/upvote?slug=${encodeURIComponent(postSlug)}${trackView ? '&trackView=true' : ''}`;
            const response = await fetch(url, { method: 'GET' });
            if (!response.ok) throw new Error('Failed to fetch count');
            const data = await response.json();
            upvoteCount.textContent = data.count;
            if (trackView) sessionStorage.setItem(viewStorageKey, 'true');
          } catch (error) {
            console.error('Error fetching counts:', error);
          } finally {
            upvoteLoading.classList.add('hidden');
            upvoteCount.classList.remove('opacity-50');
            upvoteButton.setAttribute('aria-busy', 'false');
          }
        }

        await fetchCounts(!hasViewed);
        let hasUpvoted = localStorage.getItem(storageKey) === 'true';
        if (hasUpvoted) upvoteButton.classList.add('upvoted');

        upvoteButton.addEventListener('click', async function() {
          if (hasUpvoted) {
            upvoteMessage.textContent = 'Already upvoted.';
            upvoteMessage.classList.remove('hidden');
            setTimeout(() => {
              upvoteMessage.classList.add('hidden');
              upvoteMessage.textContent = 'Thanks for the upvote.';
            }, 3000);
            return;
          }
          try {
            upvoteButton.setAttribute('aria-busy', 'true');
            upvoteButton.disabled = true;
            upvoteLoading.classList.remove('hidden');
            upvoteCount.classList.add('opacity-50');
            const response = await fetch('/.netlify/functions/upvote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug: postSlug })
            });
            if (!response.ok) throw new Error('Network response was not ok');
            const data = await response.json();
            upvoteCount.textContent = data.count;
            localStorage.setItem(storageKey, 'true');
            hasUpvoted = true;
            upvoteButton.classList.add('upvoted');
            upvoteMessage.classList.remove('hidden');
            setTimeout(() => upvoteMessage.classList.add('hidden'), 3000);
          } catch (error) {
            console.error('Error upvoting:', error);
          } finally {
            upvoteLoading.classList.add('hidden');
            upvoteCount.classList.remove('opacity-50');
            upvoteButton.setAttribute('aria-busy', 'false');
            upvoteButton.disabled = false;
          }
        });
      });
    </script>

    {%- if collections.posts %}
      {%- set currentTags = tags | filterTagList %}
      {%- set relatedPosts = [] %}

      {%- for post in collections.posts %}
        {%- if post.url != page.url %}
          {%- set postTags = post.data.tags | filterTagList %}
          {%- set sharedTags = [] %}
          {%- for tag in currentTags %}
            {%- if tag in postTags %}
              {%- set sharedTags = (sharedTags.push(tag), sharedTags) %}
            {%- endif %}
          {%- endfor %}
          {%- if sharedTags.length > 0 %}
            {%- set relatedPosts = (relatedPosts.push({post: post, score: sharedTags.length}), relatedPosts) %}
          {%- endif %}
        {%- endif %}
      {%- endfor %}

      {%- set sortedRelated = relatedPosts | sort(attribute='score') | reverse %}

      {%- set currentFolder = null %}
      {%- for folder in collections.postFolders %}
        {%- for p in folder.posts %}
          {%- if p.url == page.url %}
            {%- set currentFolder = folder %}
          {%- endif %}
        {%- endfor %}
      {%- endfor %}

      {%- if currentFolder %}
        <section class="series-callout not-prose mt-6">
          <div class="surface surface-padding flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              {% feather "folder", class="w-4 h-4 shrink-0 opacity-70" %}
              <span class="editorial-support m-0">Part of the <strong>{{ currentFolder.name }}</strong> series.</span>
            </div>
            <a href="{{ currentFolder.url | url }}" class="post-series-link">
              View all {{ currentFolder.posts.length }} posts {% feather "arrow-right", class="w-3.5 h-3.5" %}
            </a>
          </div>
        </section>
      {%- endif %}

      {%- if sortedRelated.length > 0 %}
        <section class="related-posts not-prose mt-6">
          <h3 class="post-panel-title mb-3 flex items-center gap-2">
            {% feather "link", class="w-4 h-4" %}
            Related Writing
          </h3>
          <div class="space-y-2">
            {%- for item in sortedRelated | head(3) %}
              <div class="border-l-2 border-gray-300 dark:border-gray-600 pl-3 py-1">
                <a href="{{ item.post.url | url }}" class="editorial-title-link-compact title-hover no-underline">
                  {{ item.post.data.title }}
                </a>
                {% if item.post.data.description %}
                  <p class="editorial-support-compact m-0 mt-0.5">{{ item.post.data.description }}</p>
                {% endif %}
              </div>
            {%- endfor %}
          </div>
        </section>
      {%- endif %}

      {%- if currentFolder %}
        {%- set nextPost = currentFolder.posts | getNextCollectionItem(page) %}
        {%- set previousPost = currentFolder.posts | getPreviousCollectionItem(page) %}
      {%- else %}
        {%- set nextPost = collections.posts | getNextCollectionItem(page) %}
        {%- set previousPost = collections.posts | getPreviousCollectionItem(page) %}
      {%- endif %}
      {%- if nextPost or previousPost %}
        <nav aria-label="Post navigation" class="flex flex-col gap-0 not-prose mt-6">
          {%- if nextPost %}
            <a class="post-nav-link title-hover" href="{{ nextPost.url | url }}">
              <span class="post-nav-kicker">{% if currentFolder %}Next in Series{% else %}Next{% endif %} →</span>
              <span class="post-nav-title">{{ nextPost.data.title }}</span>
            </a>
          {%- endif %}
          {%- if previousPost %}
            <a class="post-nav-link title-hover" href="{{ previousPost.url | url }}">
              <span class="post-nav-kicker">← {% if currentFolder %}Previous in Series{% else %}Previous{% endif %}</span>
              <span class="post-nav-title">{{ previousPost.data.title }}</span>
            </a>
          {%- endif %}
        </nav>
      {%- endif %}
    {%- endif %}

    {% if conversationPlacement == 'inline' %}
      {{ commentPointer({ variant: 'inline' }) | safe }}
    {% endif %}

    <div class="comments mt-8" id="post-comments">
      <script>
        const getTheme = window.localStorage && window.localStorage.getItem("theme");
        const theme = getTheme === "dark" ? "dark" : "light";
        
        const script = document.createElement('script');
        script.src = "https://giscus.app/client.js";
        script.setAttribute("data-repo", "carteakey/carteakey.dev");
        script.setAttribute("data-repo-id", "R_kgDOIHTsrg");
        script.setAttribute("data-category", "Announcements");
        script.setAttribute("data-category-id", "DIC_kwDOIHTsrs4CnZpB");
        script.setAttribute("data-mapping", "specific");
        script.setAttribute("data-term", {{ (giscusTerm or page.url) | dump | safe }});
        script.setAttribute("data-strict", "0");
        script.setAttribute("data-reactions-enabled", "0");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "bottom");
        script.setAttribute("data-theme", theme);
        script.setAttribute("data-lang", "en");
        script.crossOrigin = "anonymous";
        script.async = true;
        
        document.querySelector("div.comments").appendChild(script);

        const mutationObserver = new MutationObserver((mutationsList) => {
          mutationsList.forEach((mutation) => {
            if (mutation.attributeName === "class") {
              const iframe = document.querySelector('.giscus-frame');
              if (iframe) {
                const theme = document.documentElement.classList.contains("dark") ? "dark" : "light";
                iframe.contentWindow.postMessage(
                  { giscus: { setConfig: { theme } } },
                  'https://giscus.app'
                );
              }
            }
          });
        });
        mutationObserver.observe(document.documentElement, { attributes: true });
      </script>
    </div>
  </article>

  <script>
    (() => {
      const bar = document.getElementById("readingProgressBar");
      const body = document.querySelector(".post-body");
      if (!bar || !body) return;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) bar.style.transition = "none";

      const update = () => {
        const rect = body.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = -rect.top;
        const pct = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;
        bar.style.width = pct + "%";
      };

      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);

      const tocLinks = document.querySelectorAll(".toc-list a[href^='#']");
      if (tocLinks.length) {
        const linksById = new Map();
        tocLinks.forEach((a) => linksById.set(decodeURIComponent(a.getAttribute("href").slice(1)), a));
        const headings = Array.from(body.querySelectorAll("h2[id], h3[id]")).filter((h) => linksById.has(h.id));

        const setActive = (id) => {
          tocLinks.forEach((a) => a.classList.remove("toc-active"));
          const active = linksById.get(id);
          if (active) active.classList.add("toc-active");
        };

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            if (visible.length) setActive(visible[0].target.id);
          },
          { rootMargin: "-15% 0px -70% 0px" }
        );
        headings.forEach((h) => observer.observe(h));
      }
    })();
  </script>

  <script>
    (() => {
      const postWrap = document.querySelector(".post-wrap");
      const shell = document.querySelector(".post-shell");
      const leftRail = document.querySelector(".post-rail-left");
      const rightRail = document.querySelector(".post-rail-right");
      if (!postWrap || !shell) return;

      const SAFETY_GAP = 8;

      const updateBleed = () => {
        if (window.innerWidth < 1280) return;
        const shellRect = shell.getBoundingClientRect();
        if (leftRail && leftRail.offsetParent) {
          const gap = shellRect.left - leftRail.getBoundingClientRect().right - SAFETY_GAP;
          postWrap.style.setProperty("--wide-bleed-left", Math.max(0, gap) + "px");
        } else {
          postWrap.style.setProperty("--wide-bleed-left", "14rem");
        }
        if (rightRail && rightRail.offsetParent) {
          const gap = rightRail.getBoundingClientRect().left - shellRect.right - SAFETY_GAP;
          postWrap.style.setProperty("--wide-bleed-right", Math.max(0, gap) + "px");
        }
      };

      updateBleed();
      window.addEventListener("resize", updateBleed);
    })();
  </script>
</div>
