---
layout: layouts/base.njk
---

{% include "components/breadcrumbs.njk" %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

<article class="site-content note-content">
  <header class="not-prose mb-4">
    <div class="flex items-center gap-2 mb-1 flex-wrap">
      <span class="meta-text text-xs uppercase tracking-wide">Infographic</span>
      <time datetime="{{ page.date | htmlDateString }}" class="meta-text text-xs">· {{ page.date | readableDate }}</time>
      <span class="post-meta-chip" data-view-counter data-view-slug="infographic:{{ page.fileSlug }}">
        {% feather "eye", class="w-3.5 h-3.5 opacity-60" %}
        <span data-view-count>-</span> views
      </span>
      {{ authorshipBadge(authored_by) }}
    </div>
    <h1 class="note-entry-title">{{ title }}</h1>
    {% if description %}
      <p class="feed-summary mt-2">{{ description }}</p>
    {% endif %}
  </header>

  <div class="my-6">
    {% if image %}
      <a href="{{ image }}" target="_blank" rel="noopener noreferrer" class="surface block overflow-hidden">
        <img src="{{ image }}" alt="{{ imageAlt or title }}" class="w-full h-auto block m-0" loading="eager">
      </a>
      <p class="feed-summary text-center mt-2 italic">Click image to view or download full-resolution asset (1200 × 1540 px)</p>
    {% endif %}
  </div>

  <div>
    {{ content | safe }}
  </div>

  <footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
    <a href="{{ '/infographics/' | url }}" class="note-entry-backlink">← All Infographics</a>
  </footer>
</article>
