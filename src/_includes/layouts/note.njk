---
layout: layouts/base.njk
---
{% include "components/breadcrumbs.njk" %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

<article class="site-content note-content">
  <header class="not-prose mb-4">
    <div class="flex items-center gap-2 mb-1 flex-wrap">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-purple-400"></span>
      <span class="meta-text text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide">Note</span>
      <time datetime="{{ page.date | htmlDateString }}" class="meta-text text-xs text-gray-400 dark:text-gray-500">· {{ page.date | readableDate }}</time>
      {{ authorshipBadge(authored_by) }}
      {% set tUrl = tweet_url or tweetUrl %}
      {% if tUrl %}
        <span class="meta-text text-xs text-gray-400 dark:text-gray-500">·</span>
        <a href="{{ tUrl }}" target="_blank" rel="noopener noreferrer" class="meta-text text-xs hover:text-[var(--accent-color)] transition-colors inline-flex items-center gap-1">
          <span>X / Twitter</span>
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline opacity-70"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      {% endif %}
    </div>
    <h1 class="note-entry-title">{{ title }}</h1>
  </header>

  <div class="flex justify-end mt-4 mb-2">
    {% include "components/copy-markdown.njk" %}
  </div>

  <div>
    {{ content | safe }}
  </div>

  <footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
    <a href="{{ '/feed/' | url }}" class="note-entry-backlink">← Back to feed</a>
  </footer>
</article>
