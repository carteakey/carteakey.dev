---
layout: layouts/base.njk
---

{% include "components/breadcrumbs.njk" %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

<header class="not-prose mb-4">
  <div class="flex items-center gap-2 mb-1 flex-wrap">
    <span class="badge badge-type badge-compact badge-type-til">TIL</span>
    <time datetime="{{ page.date | htmlDateString }}" class="meta-text">{{ page.date | readableDate }}</time>
    {% if source %}
      <span class="meta-text">· <a href="{{ source }}" target="_blank" rel="noopener" class="editorial-meta-link no-underline">Source ↗</a></span>
    {% endif %}
    {{ authorshipBadge(authored_by) }}
    <span class="ml-auto">{% include "components/copy-markdown.njk" %}</span>
  </div>
  <h1 class="editorial-title mt-1 m-0">{{ title }}</h1>
</header>

<article class="site-content">
  {{ content | safe }}
</article>

<footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
  <a href="{{ '/notes/?type=til' | url }}" class="editorial-meta-link no-underline">← All TILs in The Log</a>
</footer>
