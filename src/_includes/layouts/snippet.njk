---
layout: layouts/base.njk
---

{% include "components/breadcrumbs.njk" %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

<article class="snippet mx-auto w-full xl:max-w-3xl min-w-0 space-y-4">
  <header class="not-prose space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge badge-type badge-compact badge-type-snippet">Snippet</span>
      <time datetime="{{ page.date | htmlDateString }}" class="meta-text">{{ page.date | readableDate }}</time>
      {% if language %}
        <span class="badge badge-tag badge-compact">{{ language }}</span>
      {% endif %}
      {{ authorshipBadge(authored_by) }}
      {% if tags %}
        {% for tag in tags | filterTagList %}
          <a href="/tags/{{ tag | slugify }}/" class="badge badge-tag badge-compact badge-interactive no-underline">#{{ tag }}</a>
        {% endfor %}
      {% endif %}
      <span class="ml-auto">{% include "components/copy-markdown.njk" %}</span>
    </div>
    <h1 class="editorial-title m-0">{{ title }}</h1>
  </header>

  <div class="snippet-content site-content space-y-4">
    {{ content | safe }}
  </div>

  <footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
    <a href="{{ '/notes/?type=snippet' | url }}" class="editorial-meta-link no-underline">← All code snippets</a>
  </footer>
</article>
