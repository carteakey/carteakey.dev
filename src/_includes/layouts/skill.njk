---
layout: layouts/base.njk
---

{% include "components/breadcrumbs.njk" %}

<article class="mx-auto w-full xl:max-w-3xl">
  <header class="not-prose mb-6">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-purple-400"></span>
      <span class="meta-text text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide">Agent skill</span>
      <time datetime="{{ page.date | htmlDateString }}" class="meta-text text-xs text-gray-400 dark:text-gray-500">· {{ page.date | readableDate }}</time>
      {% if sourceName %}<span class="meta-text text-xs text-gray-400 dark:text-gray-500">· {{ sourceName }}</span>{% endif %}
    </div>
    <h1 class="text-2xl font-semibold tracking-tight mt-1 mb-2">{{ title }}</h1>
    <p class="editorial-support mb-4">{{ description }}</p>
    <a href="{{ fileUrl }}" target="_blank" rel="noopener" class="page-header-link accent-link inline-flex items-center gap-1.5">View SKILL.md {% feather "external-link", class="w-3.5 h-3.5" %}</a>
  </header>

  <div class="site-content">
    <h2>Notes</h2>
    {{ content | safe }}
  </div>
</article>

<footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
  <a href="{{ '/skills/' | url }}" class="text-sm text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" style="text-decoration: none;">← All skills</a>
</footer>
