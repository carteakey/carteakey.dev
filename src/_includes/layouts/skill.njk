---
layout: layouts/base.njk
---

{% include "components/breadcrumbs.njk" %}

<article class="mx-auto w-full xl:max-w-3xl">
  <header class="not-prose mb-6">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="badge badge-type badge-compact">Agent skill</span>
      <time datetime="{{ page.date | htmlDateString }}" class="meta-text">· {{ page.date | readableDate }}</time>
      <span class="post-meta-chip" data-view-counter data-view-slug="skill:{{ page.fileSlug }}">
        {% feather "eye", class="w-3.5 h-3.5 opacity-60" %}
        <span data-view-count>-</span> views
      </span>
      {% if sourceName %}<span class="meta-text">· {{ sourceName }}</span>{% endif %}
    </div>
    <h1 class="editorial-title mt-1 mb-2">{{ title }}</h1>
    <p class="editorial-support mb-4">{{ description }}</p>
    <a href="{{ fileUrl }}" target="_blank" rel="noopener" class="page-header-link accent-link inline-flex items-center gap-1.5">View SKILL.md {% feather "external-link", class="w-3.5 h-3.5" %}</a>
  </header>

  <div class="site-content">
    <h2>Notes</h2>
    {{ content | safe }}
  </div>
</article>

<footer class="not-prose mt-8 pt-4 border-t border-gray-200 dark:border-gray-800">
  <a href="{{ '/ai/skills/' | url }}" class="editorial-meta-link no-underline">← All agent skills</a>
</footer>
