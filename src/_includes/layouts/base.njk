<!DOCTYPE html>
<html lang="{{ language or metadata.language }}"{% if direction %} dir="{{ direction }}"{% endif %} class="scroll-smooth">

<head>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/static/fonts/plus-jakarta-sans/PlusJakartaSans[wght].woff2?v={{ versions.version }}" as="font" type="font/woff2" crossorigin />

  {# Fraunces: monumental display serif, used sparingly for hero headlines #}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Press+Start+2P&display=swap" />

  {# Site fonts are self-hosted via src/static/fonts/. #}
  <meta name="generator" content="Eleventy">
  <link id="prism-theme" href="/static/css/prism/prism-light.css?v={{ versions.version }}" rel="stylesheet"/>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DKK1XXJY42"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-DKK1XXJY42");
  </script>

  <script src="/static/js/theme.js?v={{ versions.version }}" data-asset-version="{{ versions.version }}"></script>
  <script src="/static/js/ai-filter.js?v={{ versions.version }}"></script>
  
  <script defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script defer src="/static/js/alpine.min.js?v={{ versions.version }}"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#14b8a6" id="theme-color-meta">
  {% set resolvedCanonicalUrl = canonicalUrl or (page.url | absoluteUrl(metadata.url)) %}
  {% set resolvedDescription = seoDescription or description or metadata.description %}
  <title>{{ title or metadata.title }}</title>
  <meta name="description" content="{{ resolvedDescription }}" />
  <meta name="generator" content="{{ eleventy.generator }}" />
  {% if hidden or draft %}
  <meta name="robots" content="noindex, nofollow" />
  {% endif %}
  
  {# Open Graph / Facebook Meta Tags #}
  <meta property="og:type" content="{% if templateClass == 'tmpl-post' %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="{{ resolvedCanonicalUrl }}" />
  <meta property="og:site_name" content="{{ metadata.title }}" />
  <meta property="og:title" content="{{ title or metadata.title }}" />
  <meta property="og:description" content="{{ resolvedDescription }}" />
  {% if image %}
  <meta property="og:image" content="{{ image | absoluteUrl(metadata.url) }}" />
  {% else %}
  <meta property="og:image" content="{{ '/img/avatar.png' | absoluteUrl(metadata.url) }}" />
  {% endif %}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="{{ ogLocale or 'en_CA' }}" />
  {% for translation in translations | default([]) %}
    {% if translation.language != (language or metadata.language) and translation.ogLocale %}
  <meta property="og:locale:alternate" content="{{ translation.ogLocale }}" />
    {% endif %}
  {% endfor %}
  
  {# Article specific Open Graph tags #}
  {% if templateClass == 'tmpl-post' %}
  <meta property="article:published_time" content="{{ page.date | htmlDateString }}" />
  {% if updated %}
  <meta property="article:modified_time" content="{{ updated | htmlDateString }}" />
  {% endif %}
  <meta property="article:author" content="{{ metadata.author.name }}" />
  {% for tag in tags | filterTagList %}
  <meta property="article:tag" content="{{ tag }}" />
  {% endfor %}
  {% endif %}
  
  {# Twitter Card Meta Tags #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="{{ resolvedCanonicalUrl }}" />
  <meta name="twitter:title" content="{{ title or metadata.title }}" />
  <meta name="twitter:description" content="{{ resolvedDescription }}" />
  {% if image %}
  <meta name="twitter:image" content="{{ image | absoluteUrl(metadata.url) }}" />
  {% else %}
  <meta name="twitter:image" content="{{ '/img/avatar.png' | absoluteUrl(metadata.url) }}" />
  {% endif %}
  <meta name="twitter:creator" content="@carteakey" />
  <meta name="twitter:site" content="@carteakey" />
  
  {# Additional SEO Meta Tags #}
  <meta name="author" content="{{ metadata.author.name }}" />
  <link rel="canonical" href="{{ resolvedCanonicalUrl }}" />
  {% for translation in translations | default([]) %}
  <link rel="alternate" hreflang="{{ translation.language }}" href="{{ translation.url | absoluteUrl(metadata.url) }}" />
    {% if translation.language == metadata.language %}
  <link rel="alternate" hreflang="x-default" href="{{ translation.url | absoluteUrl(metadata.url) }}" />
    {% endif %}
  {% endfor %}
  
  <link rel="stylesheet" href="{{ '/css/tailwind.css' | url }}?v={{ versions.version }}" />

  <link rel="alternate" type="application/atom+xml" title="{{ metadata.title }} - Atom Feed" href="{{ '/feed.xml' | url }}">
  
  {# JSON-LD Structured Data for Website #}
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ metadata.title }}",
    "url": "{{ metadata.url }}",
    "description": "{{ metadata.description }}",
    "author": {
      "@type": "Person",
      "name": "{{ metadata.author.name }}",
      "email": "{{ metadata.author.email }}",
      "url": "{{ metadata.author.url }}"
    },
    "publisher": {
      "@type": "Person",
      "name": "{{ metadata.author.name }}",
      "url": "{{ metadata.url }}"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ metadata.url }}/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  {% endif %}
</head>
{% set showReadingFrame = false %}
<body class="bg-[#fbfaf6] dark:bg-[#141414] font-sans text-sm">
  {# Skip to main content link for accessibility #}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-sm focus:font-semibold focus:text-black" style="background: var(--accent-color);">
    Skip to main content
  </a>
  
  <div
   class="md:max-w-2xl lg:max-w-4xl xl:max-w-5xl 2xl:max-w-[82rem] mx-auto {% if showReadingFrame %} md:bg-gray-100/95  md:dark:bg-zinc-950/90 md:ring-1 md:ring-amber-100/40 md:dark:ring-zinc-800/40 md:px-28 lg:px-32 md:py-10 md:rounded-none{% endif %}">
    <div class="site-content px-4 md:px-0">
      <nav class="not-prose flex w-full py-2 border-b border-gray-300/80 dark:border-gray-800 mb-3">

        {% set navPages = collections.all | eleventyNavigation %}

        <div class="flex flex-row w-full justify-between items-center gap-4">

          {# Site title - same on desktop and mobile, consistent font #}
          <a class="no-underline hover:no-underline font-mono font-bold text-[0.84rem] uppercase tracking-[0.08em] group flex items-center shrink-0" href="{{ '/' | url }}" style="color: var(--accent-color)">
            carteakey.dev
          </a>

          <ul class="list-none m-0 p-0 flex items-center gap-2">
            {# Mobile: hamburger menu for the primary links hidden below sm - previously
               About/Writing/Now had no mobile access point at all except the footer. #}
            <li class="flex items-center relative sm:hidden" x-data="{ open: false }" @keydown.escape="open = false" @click.outside="open = false">
              <button type="button" @click="open = !open" :aria-expanded="open.toString()"
                class="font-medium no-underline inline-flex items-center justify-center p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-colors"
                style="color: var(--accent-color)" title="Menu" aria-label="Main menu">
                {% feather "menu", class="w-4 h-4" %}
              </button>
              <div x-show="open" x-transition.opacity.duration.100ms @click="open = false"
                class="nav-dropdown-menu" role="menu" aria-label="Main menu" style="display: none;">
                {%- for entry in navPages %}
                  {% if entry.title == "About" or entry.title == "Writing" or entry.title == "Now" %}
                    <a href="{{ entry.url }}" class="nav-dropdown-item" role="menuitem">{{ entry.title }}</a>
                  {% endif %}
                {%- endfor %}
              </div>
            </li>

            {# Desktop: Main navigation items #}
            {%- for entry in navPages %}
              {% if entry.title == "About" or entry.title == "Writing" or entry.title == "Now" %}
                <li class="px-1.5 sm:px-2 py-1 transition-all hidden sm:flex items-center">
                  <a class="font-mono font-medium no-underline link-glow text-[0.74rem] uppercase tracking-[0.06em]" href="{{ entry.url }}">{{ entry.title }}</a>
                </li>
              {% endif %}
            {%- endfor %}

            {% if translations and translations.length > 1 %}
              <li class="flex items-center gap-1 border-l border-gray-300 dark:border-gray-700 pl-2" aria-label="Language">
                {% for translation in translations %}
                  <a
                    href="{{ translation.url }}"
                    hreflang="{{ translation.language }}"
                    lang="{{ translation.language }}"
                    class="font-mono text-[0.68rem] no-underline px-1 py-0.5 {% if translation.language == (language or metadata.language) %}font-bold border-b-2{% else %}opacity-60 hover:opacity-100{% endif %}"
                    {% if translation.language == (language or metadata.language) %}aria-current="page"{% endif %}
                    aria-label="Read this page in {{ translation.label }}"
                    {% if translation.language == (language or metadata.language) %}style="border-color: var(--accent-color)"{% endif %}
                  >{{ translation.shortLabel or translation.language | upper }}</a>
                {% endfor %}
              </li>
            {% endif %}

            <li class="flex items-center">
              <a class="font-medium no-underline inline-flex items-center justify-center p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-colors" href="{{ '/search/' | url }}" title="Search" aria-label="Search" style="color: var(--accent-color)">
                {% feather "search", class="w-4 h-4" %}
              </a>
            </li>

            <li class="flex items-center">
              <a class="font-medium no-underline inline-flex items-center justify-center p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-colors" href="{{ '/more/' | url }}" title="More pages" aria-label="More pages" style="color: var(--accent-color)">
                {% feather "compass", class="w-4 h-4" %}
              </a>
            </li>

            <li class="flex items-center relative" x-data="{ open: false }" @keydown.escape="open = false" @click.outside="open = false">
              <button type="button" @click="open = !open" :aria-expanded="open.toString()"
                class="ai-filter-trigger font-medium no-underline inline-flex items-center justify-center p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-colors"
                style="color: var(--accent-color)" title="Filter content by authorship" aria-label="Filter content by authorship">
                {% feather "filter", class="w-4 h-4" %}
              </button>
              <div id="aiFilterToggle" x-show="open" x-transition.opacity.duration.100ms @click="open = false"
                class="nav-dropdown-menu" role="group" aria-label="AI content filter" style="display: none;">
                <button type="button" data-ai-filter-option="all" class="nav-dropdown-item" aria-label="Show all content">
                  {% feather "eye", class="w-3.5 h-3.5" %} All content
                </button>
                <button type="button" data-ai-filter-option="no-generated" class="nav-dropdown-item" aria-label="Hide AI-generated content">
                  {% feather "zap", class="w-3.5 h-3.5" %} Hide AI-generated
                </button>
                <button type="button" data-ai-filter-option="human-only" class="nav-dropdown-item" aria-label="Show only human-written content">
                  {% feather "edit-2", class="w-3.5 h-3.5" %} Human-written only
                </button>
              </div>
            </li>

            <li class="flex items-center">
              <button id="toggleDarkMode" class="font-medium text-xs p-1.5 transition-all border border-transparent hover:border-gray-300 dark:hover:border-gray-700 focus-ring inline-flex items-center justify-center" aria-label="Toggle dark mode" style="color: var(--accent-color)">
                {% feather "moon" , class="block dark:hidden w-4 h-4" %}
                {% feather "sun" , class="hidden dark:block w-4 h-4"%}
              </button>
            </li>
          </ul>

        </div>

      </nav>

      {% if underConstruction %}
      <aside class="construction-notice" role="status" aria-label="This page is under construction">
        <span class="construction-notice-icon" aria-hidden="true">🚧</span>
        <span class="construction-notice-label">Under construction</span>
      </aside>
      {% endif %}

      <main id="main-content" class="{% if fullWidth %}-mx-[calc(50vw-50%)] w-screen px-4 md:px-8{% endif %} {% if templateClass %}{{ templateClass }}{% endif %}">

        {{ content | safe }}

          <script>
            document
              .getElementById("toggleDarkMode")
              .addEventListener("click", function () {
                if (isDarkMode()) {
                  localStorage.theme = "light";
                  document.documentElement.classList.remove("dark");
                } else {
                  localStorage.theme = "dark";
                  document.documentElement.classList.add("dark");
                }
                switchPrismTheme();
                if (typeof window.syncThemeColorMeta === "function") {
                  window.syncThemeColorMeta();
                }
              });

          </script>
      </main>

      <footer class="not-prose flex w-full pt-3 pb-2 flex-col md:flex-row justify-between items-center gap-3 border-t border-gray-300/80 dark:border-gray-700 mt-6">
        {% if spotify.nowPlaying and page.url != "/status/" %}
        <div class="footer-track flex items-center gap-2 not-prose">
          <img id="track-image" class="w-5 h-5 rounded-sm animate-spin-slow"
            src="{{ spotify.nowPlaying.albumImageUrl }}" alt="{{ spotify.nowPlaying.title }}" width="20" height="20" loading="lazy">
          <span class="footer-track-label">Now playing</span>
          <a href={{ spotify.nowPlaying.songUrl }} target='_blank' class='footer-track-link'>{{ spotify.nowPlaying.title }}</a>
          <span> - {{ spotify.nowPlaying.artist }}</span>
        </div>
        {% else %}
        <div></div>
        {% endif %}
        <div class='flex items-center gap-1 not-prose'>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="https://www.linkedin.com/in/kartikeychauhan/" title="LinkedIn" aria-label="LinkedIn">{% feather "linkedin", class="w-4 h-4" %}</a>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="https://github.com/carteakey" title="GitHub" aria-label="GitHub">{% feather "github", class="w-4 h-4" %}</a>
          <span class="text-gray-300 dark:text-gray-600">|</span>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="{{ '/search/' | url }}" title="Search" aria-label="Search">{% feather "search", class="w-4 h-4" %}</a>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="{{ '/feed.xml' | url }}" title="RSS" aria-label="RSS">{% feather "rss", class="w-4 h-4" %}</a>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="{{ '/newsletter/' | url }}" title="Newsletter" aria-label="Newsletter">{% feather "mail", class="w-4 h-4" %}</a>
          <a class="p-1.5 border border-transparent hover:border-gray-300 dark:hover:border-gray-700 transition-all text-gray-500 dark:text-gray-400" href="{{ '/support/' | url }}" title="Support" aria-label="Support this site">{% feather "coffee", class="w-4 h-4" %}</a>
        </div>
      </footer>


      {# Footer photo band: a genuine halftone (dot size modulated by source
         luminance, same technique as the homepage avatar, not a CSS filter)
         of the Toronto skyline. Its own visible band, separate from the
         wordmark below - in the Nous Research reference, the photo-halftone
         lives in the hero and the footer is flat color + wordmark only;
         they never overlap. Keeping that separation here too.

         Day/night pair: the source photo is a daytime shot, so the "day"
         render just lets the light theme's paper background show through
         its sparse areas (same technique that caused the tonal-inversion
         bug elsewhere - here it's used deliberately, since paper-colored
         gaps correctly read as a pale sky). The "night" render keeps the
         fixed dark backdrop from before. Sun/moon icon and a few
         twinkling stars (dark mode only, respects reduced-motion) as a
         small bit of delight - the one place on the site pure flair
         over function was asked for. #}
      <div class="footer-photo-band not-prose">
        <img class="dark:hidden" src="{{ '/img/footer-landscape-halftone-day.png' | url }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
        <img class="hidden dark:block" src="{{ '/img/footer-landscape-halftone-night.png' | url }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
        <span class="footer-band-icon" aria-hidden="true">
          {% feather "sun", class="block dark:hidden w-5 h-5" %}
          {% feather "moon", class="hidden dark:block w-5 h-5" %}
        </span>
        <span class="footer-band-stars hidden dark:block" aria-hidden="true">
          <i style="--x:12%; --y:20%; --d:0s;"></i>
          <i style="--x:78%; --y:12%; --d:0.6s;"></i>
          <i style="--x:55%; --y:28%; --d:1.2s;"></i>
          <i style="--x:33%; --y:10%; --d:1.8s;"></i>
          <i style="--x:90%; --y:24%; --d:0.3s;"></i>
        </span>
      </div>

      {# Extended footer section #}
      <div class="relative overflow-hidden border-t border-gray-200 dark:border-gray-700 pt-4 pb-6 not-prose">

        {# Bold oversized wordmark, structural type rather than decoration -
           the other half of the Nous Research reference alongside the
           saturated accent and the halftone avatar. Explicit -z-10: an
           absolutely positioned element with z-index:auto still paints
           ABOVE normal-flow siblings regardless of DOM order (learned the
           hard way on the footer illustration earlier this session). #}
        <p class="footer-wordmark" aria-hidden="true">carteakey</p>

        {# Categorized footer navigation - 4-col on md+; flat link list on mobile #}

        {# Mobile: 2-col compact grid with category headings + icons #}
        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-xs md:hidden">
          <div>
            <h4 class="footer-nav-heading">Read</h4>
            <ul class="space-y-1 list-none m-0 p-0">
              <li><a href="{{ '/now' | url }}" class="footer-nav-link">{% feather "clock", class="w-3 h-3 shrink-0" %} Now</a></li>
              <li><a href="{{ '/feed' | url }}" class="footer-nav-link">{% feather "activity", class="w-3 h-3 shrink-0" %} Feed</a></li>
              <li><a href="{{ '/blog' | url }}" class="footer-nav-link">{% feather "edit-3", class="w-3 h-3 shrink-0" %} Writing</a></li>
              <li><a href="{{ '/reviews' | url }}" class="footer-nav-link">{% feather "star", class="w-3 h-3 shrink-0" %} Reviews</a></li>
              <li><a href="{{ '/snippets' | url }}" class="footer-nav-link">{% feather "code", class="w-3 h-3 shrink-0" %} Snippets</a></li>
              <li><a href="{{ '/about' | url }}" class="footer-nav-link">{% feather "user", class="w-3 h-3 shrink-0" %} About</a></li>
              <li><a href="{{ '/quotations' | url }}" class="footer-nav-link">{% feather "message-circle", class="w-3 h-3 shrink-0" %} Quotations</a></li>
            </ul>
          </div>
          <div>
            <h4 class="footer-nav-heading">Explore</h4>
            <ul class="space-y-1 list-none m-0 p-0">
              <li><a href="{{ '/projects' | url }}" class="footer-nav-link">{% feather "box", class="w-3 h-3 shrink-0" %} Projects</a></li>
              <li><a href="{{ '/prompts' | url }}" class="footer-nav-link">{% feather "terminal", class="w-3 h-3 shrink-0" %} Prompts</a></li>
              <li><a href="{{ '/gallery' | url }}" class="footer-nav-link">{% feather "image", class="w-3 h-3 shrink-0" %} Gallery</a></li>
              <li><a href="{{ '/folio' | url }}" class="footer-nav-link">{% feather "layers", class="w-3 h-3 shrink-0" %} Folio</a></li>
              <li><a href="{{ '/data' | url }}" class="footer-nav-link">{% feather "bar-chart-2", class="w-3 h-3 shrink-0" %} Data</a></li>
              <li><a href="{{ '/listening' | url }}" class="footer-nav-link">{% feather "headphones", class="w-3 h-3 shrink-0" %} Listening</a></li>
              <li><a href="{{ '/search' | url }}" class="footer-nav-link">{% feather "search", class="w-3 h-3 shrink-0" %} Search</a></li>
              <li><a href="{{ '/stats' | url }}" class="footer-nav-link">{% feather "bar-chart", class="w-3 h-3 shrink-0" %} Stats</a></li>
              <li><a href="{{ '/guestbook' | url }}" class="footer-nav-link">{% feather "message-square", class="w-3 h-3 shrink-0" %} Guestbook</a></li>
              <li><a href="{{ '/support' | url }}" class="footer-nav-link">{% feather "coffee", class="w-3 h-3 shrink-0" %} Support</a></li>
              <li><a href="{{ '/learning' | url }}" class="footer-nav-link">{% feather "check-square", class="w-3 h-3 shrink-0" %} Reading Tracker</a></li>
            </ul>
          </div>
        </div>

        {# Desktop: 4-column categorized grid #}
        <div class="hidden md:grid grid-cols-4 gap-x-4 gap-y-2 text-xs">
          
          {# Read - content for others #}
          <div>
            <h4 class="footer-nav-heading">Read</h4>
            <ul class="space-y-0.5 list-none m-0 p-0">
              <li><a href="{{ '/now' | url }}" class="footer-nav-link">{% feather "clock", class="w-3 h-3 shrink-0" %} Now</a></li>
              <li><a href="{{ '/feed' | url }}" class="footer-nav-link">{% feather "activity", class="w-3 h-3 shrink-0" %} Feed</a></li>
              <li><a href="{{ '/blog' | url }}" class="footer-nav-link">{% feather "edit-3", class="w-3 h-3 shrink-0" %} Writing</a></li>
              <li><a href="{{ '/reviews' | url }}" class="footer-nav-link">{% feather "star", class="w-3 h-3 shrink-0" %} Reviews</a></li>
              <li><a href="{{ '/snippets' | url }}" class="footer-nav-link">{% feather "code", class="w-3 h-3 shrink-0" %} Snippets</a></li>
              <li><a href="{{ '/notes' | url }}" class="footer-nav-link">{% feather "file-text", class="w-3 h-3 shrink-0" %} Notes</a></li>
              <li><a href="{{ '/til' | url }}" class="footer-nav-link">{% feather "zap", class="w-3 h-3 shrink-0" %} TIL</a></li>
              <li><a href="{{ '/reading' | url }}" class="footer-nav-link">{% feather "book-open", class="w-3 h-3 shrink-0" %} Reading</a></li>
              <li><a href="{{ '/quotations' | url }}" class="footer-nav-link">{% feather "message-circle", class="w-3 h-3 shrink-0" %} Quotations</a></li>
            </ul>
          </div>

          {# Explore - creative & fun #}
          <div>
            <h4 class="footer-nav-heading">Explore</h4>
            <ul class="space-y-0.5 list-none m-0 p-0">
              <li><a href="{{ '/projects' | url }}" class="footer-nav-link">{% feather "box", class="w-3 h-3 shrink-0" %} Projects</a></li>
