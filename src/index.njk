---
layout: layouts/home.njk
htmlTemplateEngine: "webc"
description: Personal workbench and writing index of Kartikey Chauhan. Senior Data Analyst at McAfee, exploring analytics, local AI, and homelabs.
language: en
ogLocale: en_CA
translations:
  - language: en
    label: English
    shortLabel: EN
    ogLocale: en_CA
    url: /
  - language: hi
    label: हिन्दी
    shortLabel: हिं
    ogLocale: hi_IN
    url: /hi/
---
{% from "components/feed-card.njk" import feedCard %}

{% set highlightedPost = collections.featuredPost %}
{% set feedItems = collections.feed | head(6) %}
{% set popularPosts = (collections.popularPosts | default([])) | head(5) %}
{% set homeIndexItems = [
  {
    url: "/blog/",
    name: "Writing",
    count: collections.posts | length,
    note: "Long-form writing on data, local AI, self-hosting, systems, and the internet."
  },
  {
    url: "/notes/",
    name: "Notes",
    count: collections.notes | length,
    note: "Working thoughts, small logs, experiments, and ideas that are not done yet."
  },
  {
    url: "/projects/",
    name: "Projects",
    count: projects.projects | length,
    note: "Things I build, ship, abandon, and occasionally return to with better judgment."
  },
  {
    url: "/snippets/",
    name: "Snippets",
    count: collections.snippets | length,
    note: "A collection of useful code snippets and quick tips."
  },
  {
    url: "/feed/",
    name: "Feed",
    count: "Log",
    note: "A unified timeline of everything I publish on this site."
  },
  {
    url: "/quotations/",
    name: "Quotations",
    count: collections.quotations | length,
    note: "Borrowed clarity. Lines worth keeping around because they continue to explain things."
  }
] %}

<div class="home-index-shell not-prose">
  <section class="home-intro-grid animate-enter">
    <div class="home-intro-main">
      <div class="home-avatar-shell shrink-0">
        {% image "./src/static/img/headshot.png" , "Kartikey Chauhan", "w-full h-full object-cover" %}
      </div>

      <div>
        <p class="home-eyebrow">ANALYTICS / LOCAL AI / HOMELABS / INTERNET ARCHIVES</p>
        <h1 class="home-title">Hi, I’m <span class="home-title-accent">Kartikey.</span></h1>
        <p class="home-typing-line" aria-live="polite">
          I write about <span id="homeTypedTopic" class="home-typed-topic">local AI.</span>
        </p>
        <p class="home-dek">
          Data analyst in Toronto. I write about analytics, local AI, homelabs, personal systems, and internet archives.
        </p>
        <p class="home-dek home-dek-muted">
          Grab a coffee and look around.
        </p>

        <div class="home-link-row">
          <a href="/about">About</a>
          <a href="/now">Now</a>
          <a href="/projects">Projects</a>
          <a href="/cv">CV</a>
          <a href="/feed/">Feed</a>
          <a href="/support/">Support</a>
          <a href="https://github.com/carteakey" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </div>

    <aside class="home-glance">
      <p class="home-glance-title">At A Glance</p>
      <div class="home-glance-row">
        <span class="home-glance-label">Posts</span>
        <span class="home-glance-value">{{ collections.posts | length }}</span>
      </div>
      <div class="home-glance-row">
        <span class="home-glance-label">Notes</span>
        <span class="home-glance-value">{{ collections.notes | length }}</span>
      </div>
      <div class="home-glance-row">
        <span class="home-glance-label">Projects</span>
        <span class="home-glance-value">{{ projects.projects | length }}</span>
      </div>
      <div class="home-glance-row">
        <span class="home-glance-label">Snippets</span>
        <span class="home-glance-value">{{ collections.snippets | length }}</span>
      </div>
      <div class="home-glance-row">
        <span class="home-glance-label">Quotations</span>
        <span class="home-glance-value">{{ collections.quotations | length }}</span>
      </div>
    </aside>
  </section>

  <section class="home-grid-two animate-enter stagger-1">
    {% if startHere and startHere.length %}
      <div>
        <div class="home-panel-head">
          <p class="home-panel-kicker">Featured Posts</p>
          <a href="/blog/" class="home-panel-link">All writing →</a>
        </div>

        <ul class="home-selected-list">
          {% for item in startHere %}
            <li class="home-selected-item">
              <a href="{{ item.url | url }}" class="home-selected-link">
                {% if item.image %}
                  {% post_thumbnail item.image, item.imageAlt or item.title, "home-selected-image dark:invert dark:brightness-125", 64 %}
                {% endif %}
                <span class="home-selected-copy">
                  <span class="home-selected-title">{{ item.title }}</span>
                  {% if item.note %}
                    <span class="home-selected-note">{{ item.note }}</span>
                  {% endif %}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div>
      <div class="home-panel-head">
        <p class="home-panel-kicker">Site Index</p>
        <a href="/more/" class="home-panel-link">Full map →</a>
      </div>

      <div class="home-directory-grid">
        {% for item in homeIndexItems %}
          <a href="{{ item.url }}" class="home-directory-item">
            <span class="home-directory-heading">
              <span class="home-directory-name">{{ item.name }}</span>
              <span class="home-directory-count">{{ item.count }}</span>
            </span>
            <span class="home-directory-note">{{ item.note }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="home-recent-panel animate-enter stagger-2">
      <div class="home-panel-head">
        <p class="home-panel-kicker">Recent Activity</p>
        <a href="/feed/" class="home-panel-link">All updates →</a>
      </div>

      <div
        class="home-feed-grid grid gap-3 md:grid-cols-2 lg:grid-cols-3 items-start feed-masonry"
        data-feed-masonry
        style="--feed-row-height: 16px;"
      >
        {% for item in feedItems %}
          {{ feedCard(item, {
            extraClasses: 'feed-card',
            showTags: false
          }) }}
        {% endfor %}
      </div>
  </section>

  <section class="home-newsletter-panel animate-enter stagger-3 not-prose" aria-labelledby="home-newsletter-title">
    <div>
      <p class="home-panel-kicker">Occasional dispatches</p>
      <h2 id="home-newsletter-title" class="editorial-title-compact mt-1">New writing, sent when it is ready.</h2>
      <p class="editorial-support-compact mt-1">No weekly content treadmill. Just new posts and substantial updates.</p>
    </div>
    <form
      name="newsletter"
      method="POST"
      action="/newsletter/success/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-newsletter-form
      data-newsletter-source="homepage"
      data-error-target="#homeNewsletterError"
      class="home-newsletter-form"
    >
      <input type="hidden" name="form-name" value="newsletter">
      <input type="hidden" name="source" value="homepage">
      <input type="hidden" name="consent" value="homepage-subscribe-form">
      <label class="sr-only" for="home-newsletter-bot">Do not fill this out</label>
      <input class="hidden" id="home-newsletter-bot" name="bot-field" tabindex="-1" autocomplete="off">
      <label class="sr-only" for="homeNewsletterEmail">Email address</label>
      <input
        id="homeNewsletterEmail"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="you@example.com"
        class="home-newsletter-input accent-field accent-focus"
      >
      <button type="submit" class="accent-button accent-focus home-newsletter-button">
        <span data-submit-label>Subscribe</span>
        <span class="hidden" data-submit-loading>Sending…</span>
      </button>
      <p id="homeNewsletterError" class="hidden home-newsletter-error" data-newsletter-error role="alert">That did not go through. Please try again.</p>
    </form>
  </section>

  <section class="home-quote-panel animate-enter stagger-4">
    <div class="home-panel-head">
      <p class="home-panel-kicker">Quote Of The Day</p>
    </div>

    <blockquote class="home-quote">{{ qotd.quote }}</blockquote>
  </section>
</div>

<script src="/static/js/typeit.min.js?v={{ versions.version }}"></script>
<script>
  (() => {
    const topic = document.getElementById('homeTypedTopic');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!topic || reduceMotion || typeof TypeIt === 'undefined') return;

    topic.textContent = '';

    new TypeIt(topic, {
      strings: ['local AI.', 'analytics.', 'homelabs.', 'personal systems.', 'internet archives.'],
      breakLines: false,
      speed: 54,
      deleteSpeed: 28,
      nextStringDelay: [1350, 450],
      loop: true,
      cursorChar: '▌',
      waitUntilVisible: true
    }).go();
  })();
</script>
{% include "components/feed-masonry-script.njk" %}
