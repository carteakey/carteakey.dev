---
layout: layouts/home.njk
description: Personal site and writing index of Kartikey Chauhan. Senior Data Analyst at McAfee, exploring analytics, local AI, and homelabs.
language: en
ogLocale: en_CA
---
{% from "components/feed-card.njk" import feedCard, postListRow %}
{% from "components/authorship-badge.njk" import authorshipBadge %}

{% set logTypes = ['note', 'snippet', 'til', 'quotation'] %}
{% set feedItems = collections.feed | head(12) %}

<div class="home-index-shell not-prose">
  <section class="home-intro-grid animate-enter">
    <div class="home-intro-main">
      <div class="home-avatar-shell shrink-0">
        <img src="{{ '/img/headshot-halftone.svg' | url }}" alt="Kartikey Chauhan" width="320" height="320" loading="eager" decoding="async" class="w-full h-full object-cover">
      </div>

      <div>
        <p class="home-eyebrow">ANALYTICS / LOCAL AI / HOMELABS / INTERNET ARCHIVES</p>
        <h1 class="home-title"><span class="home-title-lead">Hi<span class="home-title-comma">,</span> I’m</span> <span class="home-title-accent">Kartikey.</span></h1>
        <p class="home-dek">
          Senior Data Analyst at McAfee in Toronto. I write about product analytics, local AI inference on consumer hardware, homelabs, and personal systems.
        </p>
        <p class="home-dek home-dek-muted">
          Grab a coffee and look around.
        </p>

        <div class="home-link-row">
          <a href="/blog/">Writing</a>
          <a href="/notes/">Notes</a>
          <a href="/ai/">AI</a>
          <a href="/now/">Now</a>
          <a href="/projects/">Projects</a>
          <a href="/about/">About</a>
          <a href="/feed/">Feed</a>
          <a href="https://github.com/carteakey" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  {# ── 2-Column Split: Writing (Left) & Notes (Right) ── #}
  <section class="home-recent-panel home-recent-panel-primary animate-enter stagger-1">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      {# ── Left Column (7 cols): Writing ── #}
      <div class="lg:col-span-7">
        <div class="home-panel-head">
          <p class="home-panel-kicker">Writing</p>
          <a href="/blog/" class="home-panel-link">All {{ collections.posts | length }} posts →</a>
        </div>

        <ul class="feed-list list-none m-0 p-0">
          {% for post in collections.pinnedPosts | head(3) %}
            {{ postListRow(post, collections.feed, {}) }}
          {% endfor %}
          {% set recentCount = 0 %}
          {% for post in collections.posts | sortByDate %}
            {% if not post.data.pinned and recentCount < 6 %}
              {% set recentCount = recentCount + 1 %}
              {{ postListRow(post, collections.feed, {}) }}
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      {# ── Right Column (5 cols): Notes ── #}
      <div class="lg:col-span-5">
        <div class="home-panel-head">
          <p class="home-panel-kicker">Notes</p>
          <a href="/notes/" class="home-panel-link">All notes →</a>
        </div>

        <div class="surface divide-y divide-gray-200/70 dark:divide-gray-800/70">
          {% set logShown = 0 %}
          {% for item in collections.feed %}
            {% if item.type in logTypes and logShown < 7 %}
              {% set logShown = logShown + 1 %}
              <article class="p-3.5 group" {% if item.authored_by %}data-authored-by="{{ item.authored_by }}"{% endif %}>
                <div class="flex items-center gap-2 mb-1">
                  <span class="badge badge-type badge-compact badge-type-{{ item.type }}">
                    {% if item.type == 'note' %}Note{% elif item.type == 'snippet' %}Snippet{% elif item.type == 'til' %}TIL{% else %}Quote{% endif %}
                  </span>
                  <time datetime="{{ item.date | htmlDateString }}" class="meta-text">{{ item.date | shortDate }}</time>
                  {% if item.authored_by is defined %}{{ authorshipBadge(item.authored_by, compact=true) }}{% endif %}
                </div>
                {% if item.type == 'quotation' %}
                  <a href="{{ item.url | url }}" class="block no-underline">
                    <p class="editorial-support-compact italic m-0 line-clamp-2">{{ item.original.templateContent | striptags | trim }}</p>
                    <span class="meta-text block mt-1">- {{ item.original.data.author }}</span>
                  </a>
                {% else %}
                  <a href="{{ item.url | url }}" class="editorial-title-link-compact title-hover block no-underline">
                    {{ item.title }}
                  </a>
                  {% if item.summary %}
                    <p class="editorial-support-compact mt-0.5 m-0 line-clamp-2">{{ item.summary }}</p>
                  {% elif item.original and item.original.templateContent %}
                    <p class="editorial-support-compact mt-0.5 m-0 line-clamp-2">{{ item.original.templateContent | striptags | trim | truncate(140) }}</p>
                  {% endif %}
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </section>

  {# ── Masonry Feed ── #}
  <section class="home-recent-panel animate-enter stagger-2 mt-8">
    <div class="home-panel-head">
      <p class="home-panel-kicker">From the feed</p>
      <a href="/feed/" class="home-panel-link">All updates →</a>
    </div>

    <div
      class="home-feed-grid grid gap-3 md:grid-cols-2 lg:grid-cols-3 items-start feed-masonry"
      data-feed-masonry
    >
      {% for item in feedItems %}
        {{ feedCard(item, {
          variant: 'full',
          extraClasses: 'feed-card',
          showTags: false
        }) }}
      {% endfor %}
    </div>
  </section>

  <section class="home-newsletter-panel animate-enter stagger-3 not-prose" aria-labelledby="home-newsletter-title">
    <div class="home-newsletter-grid">
      <div class="home-newsletter-copy">
        <p class="home-panel-kicker">Weekly digest</p>
        <h2 id="home-newsletter-title" class="home-newsletter-title">Get the weekly rollup by email.</h2>
        <p class="editorial-support-compact">
          Every Sunday when there is something new: posts, notes, code snippets, and reading notes. One email, no tracking pixels.
        </p>
      </div>
      <form
        name="newsletter"
        method="POST"
        action="/newsletter/success/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-newsletter-form
        class="home-newsletter-form"
      >
        <input type="hidden" name="form-name" value="newsletter">
        <input type="hidden" name="source" value="home">
        <p class="hidden">
          <label>Don’t fill this out if you’re human: <input name="bot-field"></label>
        </p>
        <label for="home-newsletter-email" class="sr-only">Email address</label>
        <div class="newsletter-inline-controls">
          <input
            id="home-newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@domain.com"
            class="newsletter-input accent-field accent-focus"
          >
          <button type="submit" class="newsletter-submit accent-button accent-focus">Subscribe</button>
        </div>
        <p class="newsletter-status" data-newsletter-status aria-live="polite">
          Prefer RSS? <a href="/feed.xml" class="accent-link">Subscribe via Atom</a> or <a href="/newsletter/" class="accent-link">read the details</a>.
        </p>
      </form>
    </div>
  </section>

  <section class="home-quote-panel animate-enter stagger-3">
    <div class="home-panel-head">
      <p class="home-panel-kicker">Quote of the day</p>
      {% if qotd.author %}<span class="home-quote-author">{{ qotd.author }}</span>{% endif %}
    </div>
    <blockquote class="home-quote">{{ qotd.quote }}</blockquote>
  </section>
</div>

{% include "components/feed-masonry-script.njk" %}
