---
layout: layouts/base.njk
title: Bookmarks
description: A curated collection of personal blogs, reads, and webrings I recommend.
permalink: /bookmarks/
eleventyNavigation:
  key: Bookmarks
  order: 10
collectionArchetype: ledger
---

{% include "components/breadcrumbs.njk" %}

{% set blogrollCount = bookmarks.blogroll | length %}
{% set readsCount = bookmarks.artifacts | length %}
{% set webringsCount = bookmarks.webrings | length %}
{% set totalCount = blogrollCount + readsCount + webringsCount %}

{% set pageEyebrow = "Curated Web" %}
{% set pageTitle = "Bookmarks" %}
{% set pageDescription = "A curated collection of personal blogs, standout reads, and indie webrings I keep coming back to." %}
{% set itemCount = totalCount %}
{% set itemLabel = "recommendations" %}

<div class="max-w-5xl mx-auto">
  {% include "components/page-header.njk" %}

  <div class="not-prose mt-4 flex flex-wrap items-center gap-2">
    <span class="editorial-kicker">Jump to</span>
    <a href="#blogroll" class="badge badge-accent badge-compact badge-interactive no-underline">
      Blogroll ({{ blogrollCount }})
    </a>
    <a href="#reads" class="badge badge-tag badge-compact badge-interactive no-underline">
      Reads ({{ readsCount }})
    </a>
    <a href="#webrings" class="badge badge-tag badge-compact badge-interactive no-underline">
      Webrings ({{ webringsCount }})
    </a>
  </div>

  {# ── Blogroll Section ── #}
  <section id="blogroll" class="not-prose mt-12 scroll-mt-20" aria-labelledby="blogroll-heading">
    <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-800 pb-2 mb-4">
      <h2 id="blogroll-heading" class="editorial-title">Blogroll</h2>
      <span class="meta-line">{{ blogrollCount }} sites</span>
    </div>
    <p class="editorial-support mb-6">Writers, engineers, and researchers whose RSS feeds I follow regularly for high-signal ideas.</p>

    <div class="grid gap-4 md:grid-cols-2">
      {% for site in bookmarks.blogroll %}
        {% set domain = site.url | domainFromUrl %}
        <article class="surface surface-hover surface-padding flex flex-col justify-between h-full">
          <div>
            <h3 class="editorial-title-compact">
              <a href="{{ site.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 link-accent no-underline">
                <span>{{ site.name }}</span>
                {% feather "external-link", class="w-3.5 h-3.5 opacity-60" %}
              </a>
            </h3>
            <p class="editorial-support-compact mt-2">{{ site.description }}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 dark:border-gray-800/60 flex items-center justify-between gap-2">
            <span class="meta-line">{{ domain }}</span>
            {% if site.tags %}
              <div class="flex flex-wrap gap-1">
                {% for tag in site.tags %}
                  <span class="tag">#{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  {# ── Reads Section ── #}
  <section id="reads" class="not-prose mt-14 scroll-mt-20" aria-labelledby="reads-heading">
    <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-800 pb-2 mb-4">
      <h2 id="reads-heading" class="editorial-title">Reads</h2>
      <span class="meta-line">{{ readsCount }} pieces</span>
    </div>
    <p class="editorial-support mb-6">Standalone pieces, engineering philosophies, and software landmarks worth revisiting.</p>

    <div class="grid gap-4 md:grid-cols-2">
      {% for item in bookmarks.artifacts %}
        {% set domain = item.url | domainFromUrl %}
        <article class="surface surface-hover surface-padding flex flex-col justify-between h-full">
          <div>
            <h3 class="editorial-title-compact">
              <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 link-accent no-underline">
                <span>{{ item.title }}</span>
                {% feather "external-link", class="w-3.5 h-3.5 opacity-60" %}
              </a>
            </h3>
            <p class="editorial-support-compact mt-2">{{ item.description }}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 dark:border-gray-800/60 flex items-center justify-between gap-2">
            <span class="meta-line">{{ domain }}</span>
            {% if item.tags %}
              <div class="flex flex-wrap gap-1">
                {% for tag in item.tags %}
                  <span class="tag">#{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  {# ── Webrings Section ── #}
  <section id="webrings" class="not-prose mt-14 scroll-mt-20" aria-labelledby="webrings-heading">
    <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-800 pb-2 mb-4">
      <h2 id="webrings-heading" class="editorial-title">Webrings</h2>
      <span class="meta-line">{{ webringsCount }} rings</span>
    </div>
    <p class="editorial-support mb-6">Decentralized rings connecting personal homepages, indie developers, and minimal hand-crafted web spaces.</p>

    <div class="grid gap-4 md:grid-cols-2">
      {% for ring in bookmarks.webrings %}
        <article class="surface surface-hover surface-padding flex flex-col justify-between h-full">
          <div>
            <div class="flex items-start justify-between gap-3">
              <h3 class="editorial-title-compact">
                <a href="{{ ring.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 link-accent no-underline">
                  <span>{{ ring.name }}</span>
                  {% feather "external-link", class="w-3.5 h-3.5 opacity-60" %}
                </a>
              </h3>
              {% if ring.button %}
                <a href="{{ ring.url }}" target="_blank" rel="noopener noreferrer" class="shrink-0 block" title="{{ ring.name }} Webring">
                  <img src="{{ ring.button }}" alt="{{ ring.name }}" width="88" height="31" class="micro-button pixelated" loading="lazy">
                </a>
              {% endif %}
            </div>
            <p class="editorial-support-compact mt-2">{{ ring.description }}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 dark:border-gray-800/60 flex items-center justify-between gap-2">
            <span class="meta-line">{{ ring.url | domainFromUrl }}</span>
            {% if ring.tags %}
              <div class="flex flex-wrap gap-1">
                {% for tag in ring.tags %}
                  <span class="tag">#{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {# ── 88×31 Button Shelf & Carteakey Button Embed ── #}
    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      {# Left: The 88x31 Button Shelf #}
      <div class="surface surface-padding flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-gray-200/60 dark:border-gray-800/60">
            <h3 class="editorial-title-compact flex items-center gap-2">
              {% feather "grid", class="w-4 h-4 text-accent" %}
              <span>The 88×31 Button Shelf</span>
            </h3>
            <span class="meta-line font-mono text-xs">micro-buttons</span>
          </div>
          <p class="editorial-support-compact mb-4">
            A small tribute to early internet badges and independent webrings.
          </p>
          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            {# Webring buttons #}
            {% for ring in bookmarks.webrings %}
              {% if ring.button %}
                <a href="{{ ring.url }}" target="_blank" rel="noopener noreferrer" class="inline-block" title="{{ ring.name }} Webring">
                  <img src="{{ ring.button }}" alt="{{ ring.name }}" width="88" height="31" class="micro-button pixelated" loading="lazy">
                </a>
              {% endif %}
            {% endfor %}
            {# Retro buttons #}
            {% for btn in bookmarks.retro_buttons %}
              <a href="{{ btn.url }}" target="_blank" rel="noopener noreferrer" class="inline-block" title="{{ btn.name }}">
                <img src="{{ btn.image }}" alt="{{ btn.alt }}" width="88" height="31" class="micro-button pixelated" loading="lazy">
              </a>
            {% endfor %}
            {# Carteakey site button #}
            <a href="https://carteakey.dev" class="inline-block" title="carteakey.dev button">
              <img src="/img/buttons/carteakey.png" alt="carteakey.dev" width="88" height="31" class="micro-button pixelated" loading="lazy">
            </a>
          </div>
        </div>
        <p class="mt-4 pt-3 border-t border-gray-200/60 dark:border-gray-800/60 meta-line text-[0.72rem]">
          88×31 px • Pixel-rendered • No trackers
        </p>
      </div>

      {# Right: Carteakey Button Embed Snippet #}
      <div class="surface surface-padding flex flex-col justify-between" x-data="{ copied: false, embedCode: '<a href=&quot;https://carteakey.dev&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;><img src=&quot;https://carteakey.dev/img/buttons/carteakey.png&quot; alt=&quot;carteakey.dev&quot; width=&quot;88&quot; height=&quot;31&quot;></a>' }">
        <div>
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-gray-200/60 dark:border-gray-800/60">
            <h3 class="editorial-title-compact flex items-center gap-2">
              {% feather "code", class="w-4 h-4 text-accent" %}
              <span>Button for Your Site</span>
            </h3>
            <span class="meta-line font-mono text-xs">carteakey.dev</span>
          </div>
          <div class="flex items-center gap-3 mb-3">
            <img src="/img/buttons/carteakey.png" alt="carteakey.dev button" width="88" height="31" class="micro-button pixelated shrink-0">
            <p class="editorial-support-compact text-xs">
              Feel free to embed this button on your blogroll, badge shelf, or personal workbench.
            </p>
          </div>
          <div class="relative mt-2">
            <textarea 
              readonly 
              class="w-full h-16 p-2 text-[0.72rem] font-mono leading-relaxed resize-none rounded-none surface border text-inherit focus:outline-none select-all" 
              x-text="embedCode"></textarea>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-between gap-2">
          <span class="meta-line text-[0.72rem]">HTML Embed Snippet</span>
          <button 
            type="button" 
            class="badge badge-accent badge-interactive cursor-pointer inline-flex items-center gap-1.5 py-1 px-2.5 text-xs font-mono"
            @click="navigator.clipboard.writeText(embedCode); copied = true; setTimeout(() => copied = false, 2000)"
          >
            <span x-show="!copied">{% feather "copy", class="w-3 h-3" %}</span>
            <span x-show="copied">{% feather "check", class="w-3 h-3 text-accent" %}</span>
            <span x-text="copied ? 'Copied!' : 'Copy Code'"></span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {# ── Trade Links CTA ── #}
  <div class="mt-14 surface surface-padding not-prose">
    <h3 class="editorial-title-compact flex items-center gap-2">
      {% feather "rss", class="w-4 h-4 text-accent" %}
      Want to exchange links or recommend a webring?
    </h3>
    <p class="mt-2 editorial-support-compact">
      If you run a personal site, write about engineering, or maintain an indie webring, feel free to 
      <a href="mailto:{{ metadata.author.email }}" class="accent-link">reach out</a> or leave a note in the <a href="/guestbook/" class="accent-link">guestbook</a>.
    </p>
  </div>
</div>
