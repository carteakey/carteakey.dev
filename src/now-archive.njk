---
layout: layouts/base.njk
title: Now Archive
description: A timeline of past /now updates.
permalink: /now/archive/
collectionArchetype: index
---

{% include "components/breadcrumbs.njk" %}

{% set pageTitle = "Now Archive" %}
{% set pageDescription = "Past snapshots of <a href=\"/now/\" class=\"title-hover\">what I was up to</a>." %}
{% include "components/page-header.njk" %}

{% set archiveEntries = collections.nowArchive | reverse %}
{% if archiveEntries %}
<div class="not-prose relative">
  {# vertical timeline line #}
  <div class="absolute left-[0.4rem] top-2 bottom-2 w-px bg-gray-200 dark:bg-gray-800"></div>

  <ul class="list-none m-0 p-0 space-y-8 pl-7">
    {% for entry in archiveEntries %}
    <li class="relative">
      <div class="absolute -left-7 top-1.5 w-3 h-3 border-2 border-white dark:border-zinc-950 bg-[color:var(--accent-color)]"></div>
      <div class="flex items-baseline gap-3 mb-2">
        <time class="meta-line font-semibold">{{ entry.data.archiveDate | readableDate }}</time>
        <a href="{{ entry.url }}" class="editorial-meta-link no-underline">permalink →</a>
      </div>
      <div class="site-content prose-sm [&_img]:max-h-48 [&_img]:w-auto [&_img]:my-2">
        {{ entry | safeContent | safe }}
      </div>
    </li>
    {% endfor %}
  </ul>
</div>
{% else %}
<p class="editorial-support-compact">No archive entries yet.</p>
{% endif %}
