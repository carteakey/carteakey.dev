---
layout: layouts/base.njk
title: Notes
description: Short notes, code snippets, TILs, and saved quotations.
permalink: /notes/
eleventyNavigation:
  key: Notes
  order: 6
collectionArchetype: index
---

{% from "components/feed-card.njk" import feedCard %}
{% include "components/breadcrumbs.njk" %}

{% set logTypes = ['note', 'snippet', 'til', 'quotation'] %}
{% set logCount = 0 %}
{% set noteCount = 0 %}
{% set snippetCount = 0 %}
{% set tilCount = 0 %}
{% set quotationCount = 0 %}
{% for item in collections.feed %}
  {% if item.type in logTypes %}
    {% set logCount = logCount + 1 %}
    {% if item.type == 'note' %}{% set noteCount = noteCount + 1 %}{% endif %}
    {% if item.type == 'snippet' %}{% set snippetCount = snippetCount + 1 %}{% endif %}
    {% if item.type == 'til' %}{% set tilCount = tilCount + 1 %}{% endif %}
    {% if item.type == 'quotation' %}{% set quotationCount = quotationCount + 1 %}{% endif %}
  {% endif %}
{% endfor %}

{% set pageTitle = "Notes" %}
{% set pageDescription = "Short thoughts, code snippets, Today I Learned notes, and saved quotations." %}
{% set itemCount = logCount %}
{% set itemLabel = "entries" %}
{% include "components/page-header.njk" %}

<div class="not-prose">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter log by entry type">
      <button type="button" data-log-type="" class="badge badge-filter badge-compact active">All ({{ logCount }})</button>
      <button type="button" data-log-type="note" class="badge badge-filter badge-compact">Notes ({{ noteCount }})</button>
      <button type="button" data-log-type="snippet" class="badge badge-filter badge-compact">Code Snippets ({{ snippetCount }})</button>
      <button type="button" data-log-type="til" class="badge badge-filter badge-compact">TIL ({{ tilCount }})</button>
      <button type="button" data-log-type="quotation" class="badge badge-filter badge-compact">Quotations ({{ quotationCount }})</button>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <div class="relative">
        {% feather "search", class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" %}
        <input
          type="search"
          id="logSearch"
          placeholder="Search log..."
          aria-label="Search log entries"
          class="rounded-sm border border-gray-200 dark:border-gray-700 bg-transparent py-1.5 pl-8 pr-3 text-sm accent-field accent-focus focus:outline-none w-44"
        >
      </div>
      {% include "components/authorship-filter.njk" %}
    </div>
  </div>

  <div id="logStream" class="flex flex-col w-full py-4">
    {% for item in collections.feed %}
      {% if item.type in logTypes %}
        {% set searchBody = ((item.summary or '') ~ ' ' ~ (item.original.templateContent or '')) | striptags | replace('\n', ' ') | truncate(300, true, '') | lower | replace('"', '') %}
        {% set searchTags = (item.tags | default([]) | join(' ') | lower) %}
        {{ feedCard(item, {
          variant: 'stream',
          outerAttrs: 'data-log-item data-type="' ~ item.type ~ '" data-title="' ~ ((item.title or '') | lower | replace('"', '')) ~ '" data-tags="' ~ searchTags ~ '" data-body="' ~ searchBody ~ '"'
        }) }}
      {% endif %}
    {% endfor %}
  </div>
  <p id="logEmptyState" class="hidden editorial-support-compact py-8 text-center">No entries match that filter.</p>
</div>

<script>
  (() => {
    const typeButtons = Array.from(document.querySelectorAll('[data-log-type]'));
    const searchInput = document.getElementById('logSearch');
    const items = Array.from(document.querySelectorAll('[data-log-item]'));
    const emptyState = document.getElementById('logEmptyState');

    const params = new URLSearchParams(window.location.search);
    let activeType = params.get('type') || '';
    if (!['', 'note', 'snippet', 'til', 'quotation'].includes(activeType)) {
      activeType = '';
    }

    const applyFilters = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;

      typeButtons.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.logType === activeType);
      });

      items.forEach((el) => {
        const matchesType = !activeType || el.dataset.type === activeType;
        const matchesQuery =
          !query ||
          (el.dataset.title || '').includes(query) ||
          (el.dataset.tags || '').includes(query) ||
          (el.dataset.body || '').includes(query);
        const show = matchesType && matchesQuery;
        el.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      emptyState?.classList.toggle('hidden', visible > 0);
    };

    typeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeType = btn.dataset.logType || '';
        const url = new URL(window.location.href);
        if (activeType) {
          url.searchParams.set('type', activeType);
        } else {
          url.searchParams.delete('type');
        }
        window.history.replaceState({}, '', url);
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    applyFilters();
  })();
</script>
