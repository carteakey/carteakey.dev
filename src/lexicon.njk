---
layout: layouts/base.njk
title: Lexicon
description: A dictionary of elaborate developer terms, parables, and mental models.
permalink: /lexicon/
eleventyNavigation:
  key: Lexicon
  order: 9
collectionArchetype: index
---

{% from "components/view-toggle.njk" import viewToggle %}
{% from "components/feed-card.njk" import feedCard %}
{% include "components/breadcrumbs.njk" %}

{% set pageEyebrow = "Mental Models" %}
{% set pageTitle = "Lexicon" %}
{% set pageDescription = "A dictionary of elaborate developer terms, parables, and mental models." %}
{% set itemCount = collections.lexicon | length %}
{% set itemLabel = "entries" %}
{% include "components/page-header.njk" %}

<div class="not-prose" x-data="collectionView('lexicon-view', 'list', ['list', 'stream', 'grid'])">
  <div class="collection-view-toolbar collection-view-toolbar-compact">
    <p class="editorial-support-compact">Choose the reading rhythm that fits: a compact index, full definitions, or a wall.</p>
    {{ viewToggle([
      { value: "list", label: "List view", icon: "list" },
      { value: "stream", label: "Stream view", icon: "activity" },
      { value: "grid", label: "Wall view", icon: "grid" }
    ]) }}
  </div>

  {# ── LIST VIEW (default compact index) ──────────────────────── #}
  <ul class="feed-list" x-show="view === 'list'" x-cloak>
    {% for item in collections.feed %}{% if item.type == 'lexicon' %}
      {{ feedCard(item, { variant: 'list', showSummary: true, showTags: true }) }}
    {% endif %}{% endfor %}
  </ul>

  {# ── STREAM VIEW (full definitions) ─────────────────────────── #}
  <div x-show="view === 'stream'" x-cloak class="flex flex-col w-full py-4">
    {% for item in collections.feed %}{% if item.type == 'lexicon' %}
      {{ feedCard(item, { variant: 'stream' }) }}
    {% endif %}{% endfor %}
  </div>

  {# ── WALL VIEW (masonry cards) ───────────────────────────────── #}
  <div x-show="view === 'grid'" x-cloak
    class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 items-start feed-masonry"
    data-feed-masonry
  >
    {% for item in collections.feed %}{% if item.type == 'lexicon' %}
      {{ feedCard(item, { extraClasses: 'feed-card' }) }}
    {% endif %}{% endfor %}
  </div>
</div>

{% include "components/feed-masonry-script.njk" %}
